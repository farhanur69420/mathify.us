<script is:inline>
(function(){
  const g=id=>document.getElementById(id), v=id=>+g(id).value;

  // name, type, m, j, r, c, note
  const PRESETS=[
    ['Simply supported beam','frame',1,2,3,0,'Pin + roller. The baseline determinate beam.'],
    ['Cantilever beam','frame',1,2,3,0,'One fixed support: r = 3 on its own.'],
    ['Propped cantilever','frame',1,2,4,0,'Fixed + roller — one redundant reaction.'],
    ['Fixed–fixed beam','frame',1,2,6,0,'Both ends fixed: the classic 3rd-degree beam.'],
    ['Continuous beam, 3 supports','frame',2,3,4,0,'Pin + two rollers, modelled as two members.'],
    ['Beam with internal hinge','frame',2,3,4,1,'The hinge cancels the extra reaction exactly.'],
    ['Portal frame, pinned bases','frame',3,4,4,0,'Two pins: 1st-degree indeterminate.'],
    ['Portal frame, fixed bases','frame',3,4,6,0,'Two fixed bases: 3rd-degree indeterminate.'],
    ['Two-hinged arch','frame',1,2,4,0,'Four reactions, three equations.'],
    ['Three-hinged arch','frame',2,3,4,1,'The crown hinge supplies the fourth equation.'],
    ['Simple truss (13 members)','truss',13,8,3,0,'m + r = 2j exactly.'],
    ['Truss with one extra member','truss',14,8,3,0,'Internally indeterminate to 1st degree.'],
    ['Truss missing a member','truss',12,8,3,0,'A genuine mechanism — negative count.']
  ];

  const sel=g('dt-preset');
  PRESETS.forEach((p,i)=>{ const o=document.createElement('option'); o.value=i; o.textContent=p[0]; sel.appendChild(o); });

  sel.addEventListener('change',()=>{
    const i=sel.value; if(i==='') return;
    const [,t,m,j,r,c]=PRESETS[i];
    g('dt-type').value=t; g('dt-m').value=m; g('dt-j').value=j; g('dt-r').value=r; g('dt-c').value=c;
    render();
  });
  ['dt-type','dt-m','dt-j','dt-r','dt-c'].forEach(id=>g(id).addEventListener('input',()=>{
    if(id!=='dt-preset') sel.value='';
    render();
  }));

  function render(){
    const truss=g('dt-type').value==='truss';
    const m=Math.max(0,Math.round(v('dt-m'))), j=Math.max(1,Math.round(v('dt-j')));
    const r=Math.max(0,Math.round(v('dt-r'))), c=Math.max(0,Math.round(v('dt-c')));
    g('dt-crow').style.display = truss ? 'none' : 'block';
    g('dt-hint').textContent = truss
      ? 'Truss: one unknown per member, two equations per pin joint.'
      : 'Frame: three unknowns per member, three equations per joint, minus one equation per release.';

    const unknowns = truss ? m + r : 3*m + r;
    const equations = truss ? 2*j : 3*j + c;
    const i = unknowns - equations;

    const verdict = i<0
      ? ['v-fail','UNSTABLE — a mechanism', 'Fewer restraints than degrees of freedom. Add members or supports; no analysis can rescue it.']
      : i===0
        ? ['v-pass','STATICALLY DETERMINATE', 'Solvable by equilibrium alone — provided it is also geometrically stable.']
        : ['v-pass','INDETERMINATE to degree '+i, 'Needs compatibility as well as equilibrium: virtual work, moment distribution or stiffness methods.'];

    const formula = truss
      ? `i = m + r &minus; 2j = ${m} + ${r} &minus; 2(${j})`
      : `i = 3m + r &minus; 3j &minus; c = 3(${m}) + ${r} &minus; 3(${j}) &minus; ${c}`;

    g('dt-res').innerHTML=
      `<div class="res"><span>Unknowns</span><b>${unknowns}</b></div>`+
      `<div class="res"><span>Equations available</span><b>${equations}</b></div>`+
      `<div class="res"><span>${formula}</span><b>${i}</b></div>`+
      `<div class="verdict ${verdict[0]}"><span>${verdict[1]}</span><b>i = ${i}</b></div>`+
      `<div class="res" style="display:block"><span>${verdict[2]}</span></div>`+
      (i>=0 ? `<div class="verdict v-fail"><span>Now check geometry: can anything move without straining a member?</span><b>?</b></div>` : '');

    // unknowns vs equations bar chart
    const mx=Math.max(unknowns,equations,1), W=280,H=140,base=104;
    const bar=(x,val,col,lab)=>{
      const h=(val/mx)*74;
      return `<rect x="${x}" y="${base-h}" width="62" height="${h.toFixed(1)}" fill="${col}" opacity=".32" stroke="${col}"/>`+
             `<text x="${x+31}" y="${(base-h-6).toFixed(1)}" font-size="11" fill="${col}" text-anchor="middle">${val}</text>`+
             `<text x="${x+31}" y="${base+14}" font-size="9" fill="var(--txt2)" text-anchor="middle">${lab}</text>`;
    };
    g('dt-fig').innerHTML=`<svg viewBox="0 0 ${W} ${H}" style="width:100%;height:auto">
      <line x1="30" y1="${base}" x2="${W-20}" y2="${base}" stroke="var(--bdr2)"/>
      ${bar(60,unknowns,'var(--rust)','unknowns')}
      ${bar(160,equations,'var(--teal)','equations')}
      <text x="${W/2}" y="${H-6}" font-size="9" fill="${i<0?'var(--rust)':'var(--amb)'}" text-anchor="middle">${i<0?'too few equations to hold it up':(i===0?'perfectly matched':i+' redundant'+(i>1?'s':''))}</text>
    </svg>`;
  }
  render();

  document.querySelectorAll('.quiz .q').forEach(q=>{
    const btns=q.querySelectorAll('button');
    btns.forEach(btn=>btn.addEventListener('click',()=>{
      if(q.classList.contains('answered'))return;
      q.classList.add('answered');
      if(btn.dataset.v===q.dataset.a)q.classList.add('gotit');
      btns.forEach(b=>{ if(b.dataset.v===q.dataset.a)b.classList.add('correct'); else if(b===btn)b.classList.add('wrong'); });
      const a=document.querySelectorAll('.quiz .q.answered').length;
      const r=document.querySelectorAll('.quiz .q.gotit').length;
      g('quiz-score').textContent=r+' / '+a+' answered correctly so far';
    }));
  });
})();
</script>

