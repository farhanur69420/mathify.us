<script is:inline>
(function(){
  const g=id=>document.getElementById(id), v=id=>+g(id).value;

  /* ---------- cable ---------- */
  function cable(){
    const L=Math.max(2,v('cb-L')), w=Math.max(0.01,v('cb-w'));
    const d=Math.max(0.05,v('cb-d'));
    const H=w*L*L/(8*d), V=w*L/2, T=Math.hypot(H,V);
    const r=d/L, S=L*(1+8/3*r*r-32/5*Math.pow(r,4));
    g('cb-res').innerHTML=
      `<div class="res"><span>Sag ratio d/L</span><b>1 : ${(L/d).toFixed(1)}</b></div>`+
      `<div class="res"><span>H = wL&sup2;/8d  =  T<sub>min</sub></span><b>${H.toFixed(1)} kN</b></div>`+
      `<div class="res"><span>V at each support</span><b>${V.toFixed(1)} kN</b></div>`+
      `<div class="verdict v-pass"><span>T<sub>max</sub> at the supports</span><b>${T.toFixed(1)} kN</b></div>`+
      `<div class="res"><span>Support slope</span><b>${(Math.atan(4*d/L)*180/Math.PI).toFixed(1)}&deg;</b></div>`+
      `<div class="res"><span>Cable length S</span><b>${S.toFixed(2)} m  (+${(100*(S/L-1)).toFixed(2)}%)</b></div>`;

    const W=340,Ht=130,pad=26, X=t=>pad+(t/L)*(W-2*pad);
    const ymax=Math.max(d,L/4), Y=yy=>18+(yy/ymax)*(Ht-46);
    let s=`<svg viewBox="0 0 ${W} ${Ht}" style="width:100%;height:auto">`;
    s+=`<line x1="${X(0)}" y1="${Y(0)}" x2="${X(L)}" y2="${Y(0)}" stroke="var(--bdr2)" stroke-width="1" stroke-dasharray="3,3"/>`;
    let p='';
    for(let i=0;i<=60;i++){const t=L*i/60; p+=(i?' L ':'M ')+X(t).toFixed(1)+' '+Y(4*d*t*(L-t)/(L*L)).toFixed(1);}
    s+=`<path d="${p}" fill="none" stroke="var(--teal)" stroke-width="2.4"/>`;
    for(let i=1;i<12;i++){const t=L*i/12; const yy=Y(4*d*t*(L-t)/(L*L));
      s+=`<line x1="${X(t)}" y1="${Y(0)-9}" x2="${X(t)}" y2="${yy-2}" stroke="var(--mut)" stroke-width=".7"/>`;}
    s+=`<text x="${X(L/2)}" y="${Y(0)-13}" font-size="8.5" fill="var(--mut)" text-anchor="middle">w = ${w} kN/m</text>`;
    [0,L].forEach(t=>{s+=`<circle cx="${X(t)}" cy="${Y(0)}" r="3.5" fill="var(--bdr2)" stroke="var(--txt2)"/>`;});
    s+=`<line x1="${X(L/2)}" y1="${Y(0)}" x2="${X(L/2)}" y2="${Y(d)}" stroke="var(--rust)" stroke-width="1" stroke-dasharray="2,2"/>`;
    s+=`<text x="${X(L/2)+5}" y="${(Y(0)+Y(d))/2}" font-size="8.5" fill="var(--rust)">d = ${d} m</text>`;
    s+=`<text x="${X(0)}" y="${Y(d)+18}" font-size="8.5" fill="var(--teal)">T<tspan baseline-shift="sub" font-size="6">max</tspan> = ${T.toFixed(1)} kN</text>`;
    s+=`<text x="${X(L)}" y="${Y(d)+18}" font-size="8.5" fill="var(--vio)" text-anchor="end">H = ${H.toFixed(1)} kN</text>`;
    s+=`</svg>`;
    g('cb-fig').innerHTML=s;
  }
  ['cb-L','cb-d','cb-w'].forEach(id=>g(id).addEventListener('input',()=>{
    const L=Math.max(2,v('cb-L')); g('cb-r').value=Math.round(L/Math.max(0.05,v('cb-d')));
    g('cb-rv').textContent='d/L = 1/'+g('cb-r').value; cable();
  }));
  g('cb-r').addEventListener('input',()=>{
    const n=v('cb-r'); g('cb-rv').textContent='d/L = 1/'+n;
    g('cb-d').value=(Math.max(2,v('cb-L'))/n).toFixed(2); cable();
  });
  cable();

  /* ---------- arch ---------- */
  function arch(){
    const shape=g('ar-shape').value;
    const L=Math.max(4,v('ar-L')), h=Math.max(0.5,v('ar-h'));
    const w=Math.max(0,v('ar-w')), P=Math.max(0,v('ar-P'));
    const a=Math.min(Math.max(0,v('ar-a')),L);
    const x=Math.min(L, v('ar-x')/100*L);
    g('ar-xv').textContent=x.toFixed(2);

    const R=(L*L/4+h*h)/(2*h);
    const y = shape==='beam' ? (()=>0)
            : shape==='par'  ? (t=>4*h*t*(L-t)/(L*L))
            : (t=>Math.sqrt(Math.max(0,R*R-(t-L/2)*(t-L/2)))+h-R);
    const dy = shape==='beam' ? (()=>0)
             : shape==='par'  ? (t=>4*h*(L-2*t)/(L*L))
             : (t=>{const u=t-L/2, q=Math.sqrt(Math.max(1e-9,R*R-u*u)); return -u/q;});

    const VA = w*L/2 + P*(L-a)/L, VB = w*L/2 + P*a/L;
    const H  = shape==='beam' ? 0 : (VA*L/2 - w*L*L/8 - (a<L/2 ? P*(L/2-a) : 0))/h;

    const Mbeam=t=>VA*t - w*t*t/2 - (t>a?P*(t-a):0);
    const M=t=>Mbeam(t)-H*y(t);
    const Vsh=t=>VA - w*t - (t>a?P:0);

    let Mmax=0,xMax=0;
    for(let i=0;i<=400;i++){const t=L*i/400; if(Math.abs(M(t))>Math.abs(Mmax)){Mmax=M(t);xMax=t;}}
    const beamPeak=(()=>{let b=0;for(let i=0;i<=400;i++){const t=L*i/400;if(Math.abs(Mbeam(t))>Math.abs(b))b=Mbeam(t);}return b;})();

    const th=Math.atan(dy(x)), Vx=Vsh(x);
    const N=H*Math.cos(th)+Vx*Math.sin(th), Q=Vx*Math.cos(th)-H*Math.sin(th);
    const flat=Math.abs(Mmax)<1e-6*Math.max(1,Math.abs(beamPeak));

    g('ar-res').innerHTML=
      `<div class="res"><span>V<sub>A</sub> / V<sub>B</sub></span><b>${VA.toFixed(1)} / ${VB.toFixed(1)} kN</b></div>`+
      `<div class="res"><span>Horizontal thrust H</span><b>${H.toFixed(1)} kN</b></div>`+
      `<div class="res"><span>Arch height y at x</span><b>${y(x).toFixed(2)} m</b></div>`+
      `<div class="res"><span>Axis slope &theta; at x</span><b>${(th*180/Math.PI).toFixed(1)}&deg;</b></div>`+
      `<div class="res"><span>Normal thrust N at x</span><b>${N.toFixed(1)} kN</b></div>`+
      `<div class="res"><span>Radial shear Q at x</span><b>${Q.toFixed(1)} kN</b></div>`+
      `<div class="res"><span>Moment M at x</span><b>${M(x).toFixed(1)} kN&middot;m</b></div>`+
      `<div class="res"><span>Equivalent beam peak</span><b>${beamPeak.toFixed(0)} kN&middot;m</b></div>`+
      `<div class="verdict ${flat?'v-pass':'v-fail'}"><span>|M|<sub>max</sub>${flat?'':' at x = '+xMax.toFixed(1)+' m'}</span><b>${flat?'0 — pure compression':Math.abs(Mmax).toFixed(1)+' kN·m  ('+(100*Math.abs(Mmax/beamPeak)).toFixed(1)+'% of beam)'}</b></div>`;

    const W=340,padL=30,padR=16, X=t=>padL+(t/L)*(W-padL-padR);
    const archH=110, momH=76, Ht=archH+momH;
    const base=archH-34, hs=Math.max(h,0.5);
    const Ya=yy=>base-(yy/hs)*(archH-58);
    let s=`<svg viewBox="0 0 ${W} ${Ht}" style="width:100%;height:auto">`;
    s+=`<defs><marker id="arh" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="var(--teal)"/></marker>`+
       `<marker id="arr" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="var(--vio)"/></marker></defs>`;
    // UDL
    if(w>0){for(let i=0;i<=14;i++){const t=L*i/14;
      s+=`<line x1="${X(t)}" y1="13" x2="${X(t)}" y2="${Ya(y(t))-3}" stroke="var(--mut)" stroke-width=".6" opacity=".65" marker-end="url(#arh)"/>`;}
      s+=`<text x="${padL}" y="9" font-size="8" fill="var(--mut)">w = ${w} kN/m</text>`;}
    // arch axis
    let p='';
    for(let i=0;i<=90;i++){const t=L*i/90; p+=(i?' L ':'M ')+X(t).toFixed(1)+' '+Ya(y(t)).toFixed(1);}
    s+=`<path d="${p}" fill="none" stroke="var(--teal)" stroke-width="2.6"/>`;
    // parabola reference when circular
    if(shape==='cir'){let q='';
      for(let i=0;i<=90;i++){const t=L*i/90; q+=(i?' L ':'M ')+X(t).toFixed(1)+' '+Ya(4*h*t*(L-t)/(L*L)).toFixed(1);}
      s+=`<path d="${q}" fill="none" stroke="var(--vio)" stroke-width="1" stroke-dasharray="3,3" opacity=".8"/>`;
      s+=`<text x="${X(L/2)}" y="${Ya(h)-11}" font-size="7.5" fill="var(--vio)" text-anchor="middle">parabola (funicular)</text>`;}
    // point load — arrow from the top edge so it never clips, label placed inside the span
    if(P>0){s+=`<line x1="${X(a)}" y1="13" x2="${X(a)}" y2="${Ya(y(a))-3}" stroke="var(--rust)" stroke-width="2" marker-end="url(#arh)"/>`;
      s+=`<text x="${W-padR}" y="9" font-size="8.5" fill="var(--rust)" text-anchor="end">P = ${P} kN at ${a} m</text>`;}
    // crown hinge + supports
    if(shape!=='beam') s+=`<circle cx="${X(L/2)}" cy="${Ya(h)}" r="3.2" fill="var(--bg)" stroke="var(--teal)" stroke-width="1.6"/>`;
    [0,L].forEach(t=>{
      s+=`<polygon points="${X(t)},${Ya(0)} ${X(t)-6},${Ya(0)+9} ${X(t)+6},${Ya(0)+9}" fill="var(--bdr2)" stroke="var(--txt2)"/>`;
      s+=`<line x1="${X(t)}" y1="${Ya(0)+22}" x2="${X(t)}" y2="${Ya(0)+11}" stroke="var(--teal)" stroke-width="1.6" marker-end="url(#arh)"/>`;});
    s+=`<text x="${X(0)-8}" y="${Ya(0)+30}" font-size="8" fill="var(--teal)" text-anchor="middle">${VA.toFixed(0)}</text>`;
    s+=`<text x="${X(L)+8}" y="${Ya(0)+30}" font-size="8" fill="var(--teal)" text-anchor="middle">${VB.toFixed(0)}</text>`;
    if(H>0.05){
      s+=`<line x1="${X(0)-20}" y1="${Ya(0)+4}" x2="${X(0)-3}" y2="${Ya(0)+4}" stroke="var(--vio)" stroke-width="1.8" marker-end="url(#arr)"/>`;
      s+=`<line x1="${X(L)+20}" y1="${Ya(0)+4}" x2="${X(L)+3}" y2="${Ya(0)+4}" stroke="var(--vio)" stroke-width="1.8" marker-end="url(#arr)"/>`;
      s+=`<text x="${X(L/2)}" y="${Ya(0)+30}" font-size="8" fill="var(--vio)" text-anchor="middle">H = ${H.toFixed(0)} kN (thrust)</text>`;}
    // section marker
    s+=`<line x1="${X(x)}" y1="${Ya(y(x))-7}" x2="${X(x)}" y2="${Ya(y(x))+7}" stroke="var(--rust)" stroke-width="1.6"/>`;
    s+=`<circle cx="${X(x)}" cy="${Ya(y(x))}" r="2.6" fill="var(--rust)"/>`;

    // moment panel — scaled to the equivalent beam so shapes are comparable
    const mtop=archH+8, mmid=mtop+14+(momH-20)/2, amp=(momH-20)/2-4;
    const sc=Math.max(Math.abs(beamPeak),1e-6);
    const Ym=m=>mmid-(m/sc)*amp;
    s+=`<line x1="${X(0)}" y1="${Ym(0)}" x2="${X(L)}" y2="${Ym(0)}" stroke="var(--bdr2)" stroke-width="1"/>`;
    let bp='';
    for(let i=0;i<=90;i++){const t=L*i/90; bp+=(i?' L ':'M ')+X(t).toFixed(1)+' '+Ym(Mbeam(t)).toFixed(1);}
    s+=`<path d="${bp}" fill="none" stroke="var(--mut)" stroke-width="1" stroke-dasharray="3,3"/>`;
    s+=`<text x="${X(L)}" y="${mtop+4}" font-size="7.5" fill="var(--mut)" text-anchor="end">&#8211;&#8211;&#8211; equivalent beam</text>`;
    let mp='';
    for(let i=0;i<=90;i++){const t=L*i/90; mp+=(i?' L ':'M ')+X(t).toFixed(1)+' '+Ym(M(t)).toFixed(1);}
    s+=`<path d="${mp}" fill="none" stroke="${flat?'var(--grn)':'var(--rust)'}" stroke-width="2.4"/>`;
    s+=`<text x="${padL}" y="${mtop+4}" font-size="8.5" fill="var(--txt2)">Bending moment along the span</text>`;
    s+=`<line x1="${X(x)}" y1="${Ym(0)}" x2="${X(x)}" y2="${Ym(M(x))}" stroke="var(--rust)" stroke-width=".8" stroke-dasharray="2,2"/>`;
    s+=`<circle cx="${X(x)}" cy="${Ym(M(x))}" r="3" fill="${flat?'var(--grn)':'var(--rust)'}"/>`;
    if(flat) s+=`<text x="${X(L/2)}" y="${Ym(0)-7}" font-size="9" fill="var(--grn)" text-anchor="middle">M = 0 everywhere</text>`;
    s+=`</svg>`;
    g('ar-fig').innerHTML=s;
  }
  ['ar-shape','ar-L','ar-h','ar-w','ar-P','ar-a','ar-x'].forEach(id=>g(id).addEventListener('input',arch));
  arch();

  document.querySelectorAll('.quiz .q').forEach(q=>{
    const btns=q.querySelectorAll('button');
    btns.forEach(btn=>btn.addEventListener('click',()=>{
      if(q.classList.contains('answered'))return;
      q.classList.add('answered');
      btns.forEach(b=>{ if(b.dataset.v===q.dataset.a)b.classList.add('correct'); else if(b===btn)b.classList.add('wrong'); });
      const A=document.querySelectorAll('.quiz .q.answered').length;
      const R=document.querySelectorAll('.quiz .q.answered button.correct').length;
      g('quiz-score').textContent=R+' / '+A+' answered correctly so far';
    }));
  });
})();
</script>

