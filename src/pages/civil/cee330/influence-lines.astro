  const g=id=>document.getElementById(id), v=id=>+g(id).value;

  function render(){
    const L=Math.max(2,v('il-L'));
    const a=Math.min(Math.max(0,v('il-a')),L), b=L-a;
    const x=Math.min(L, v('il-x')/100*L);
    g('il-xv').textContent=x.toFixed(2);
    const show=g('il-show').value, ghost=g('il-full').checked;

    // influence-line functions of unit-load position t
    const ilR = t => (L-t)/L;
    const ilV = t => t < a ? -t/L : (L-t)/L;
    const ilM = t => t < a ? t*b/L : a*(L-t)/L;

    const cur = {R: ilR(x), V: ilV(x), M: ilM(x)};
    const peakM = a*b/L;

    g('il-res').innerHTML=
      `<div class="res"><span>Unit load at x</span><b>${x.toFixed(2)} m</b></div>`+
      `<div class="res"><span>R<sub>A</sub> = (L&minus;x)/L</span><b>${cur.R.toFixed(3)}</b></div>`+
      `<div class="res"><span>R<sub>B</sub> = x/L</span><b>${(1-cur.R).toFixed(3)}</b></div>`+
      `<div class="${Math.abs(x-a)<1e-9?'verdict v-pass':'res'}"><span>V at C (a = ${a} m)</span><b>${cur.V.toFixed(3)}</b></div>`+
      `<div class="${Math.abs(x-a)<0.02*L?'verdict v-pass':'res'}"><span>M at C</span><b>${cur.M.toFixed(3)} m ${Math.abs(x-a)<0.02*L?'— at the peak':''}</b></div>`+
      `<div class="res"><span>Peak of M IL = ab/L</span><b>${peakM.toFixed(3)} m</b></div>`+
      `<div class="res"><span>Jump in V IL at C</span><b>${((L-a)/L + a/L).toFixed(3)}</b></div>`;

    // ---- drawing ----
    const W=340, padL=30, padR=14;
    const panels=[];
    if(show==='all'||show==='R') panels.push({k:'R',f:ilR,lab:'IL for R_A',col:'var(--teal)',lo:0,hi:1});
    if(show==='all'||show==='V') panels.push({k:'V',f:ilV,lab:'IL for V at C',col:'var(--amb)',lo:-a/L,hi:b/L});
    if(show==='all'||show==='M') panels.push({k:'M',f:ilM,lab:'IL for M at C',col:'var(--vio)',lo:0,hi:peakM});
    const beamH=52, panelH=64, H=beamH+panels.length*panelH+10;
    const X=t=>padL+(t/L)*(W-padL-padR);

    // beam strip
    let s=`<svg viewBox="0 0 ${W} ${H}" style="width:100%;height:auto">`;
    const by=30;
    s+=`<line x1="${X(0)}" y1="${by}" x2="${X(L)}" y2="${by}" stroke="var(--txt2)" stroke-width="2.5"/>`;
    s+=`<polygon points="${X(0)},${by} ${X(0)-6},${by+9} ${X(0)+6},${by+9}" fill="var(--bdr2)" stroke="var(--txt2)"/>`;
    s+=`<circle cx="${X(L)}" cy="${by+6}" r="4.5" fill="var(--bdr2)" stroke="var(--txt2)"/>`;
    s+=`<line x1="${X(a)}" y1="${by-8}" x2="${X(a)}" y2="${by+12}" stroke="var(--rust)" stroke-width="1.4" stroke-dasharray="3,2"/>`;
    s+=`<text x="${X(a)}" y="${by+23}" font-size="9" fill="var(--rust)" text-anchor="middle">C</text>`;
    s+=`<line x1="${X(x)}" y1="${by-22}" x2="${X(x)}" y2="${by-3}" stroke="var(--teal)" stroke-width="2.2" marker-end="url(#ild)"/>`;
    s+=`<defs><marker id="ild" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="var(--teal)"/></marker></defs>`;
    s+=`<text x="${X(x)}" y="${by-26}" font-size="9" fill="var(--teal)" text-anchor="middle">1</text>`;
    s+=`<text x="${X(0)}" y="${by+23}" font-size="9" fill="var(--mut)" text-anchor="middle">A</text>`;
    s+=`<text x="${X(L)}" y="${by+23}" font-size="9" fill="var(--mut)" text-anchor="middle">B</text>`;

    panels.forEach((p,idx)=>{
      const top=beamH+idx*panelH, mid=top+panelH/2+4;
      const span=Math.max(Math.abs(p.hi),Math.abs(p.lo),1e-6);
      const Y=val=>mid-(val/span)*(panelH/2-12);
      // axis
      s+=`<line x1="${X(0)}" y1="${Y(0)}" x2="${X(L)}" y2="${Y(0)}" stroke="var(--bdr2)" stroke-width="1"/>`;
      // full ghost line
      const path=(from,to)=>{
        let d='',n=80,started=false;
        for(let i=0;i<=n;i++){
          const t=from+(to-from)*i/n;
          d+=(started?' L ':'M ')+X(t).toFixed(1)+' '+Y(p.f(t)).toFixed(1); started=true;
        }
        return d;
      };
      if(ghost){
        if(p.k==='V'){
          s+=`<path d="${path(0,a-1e-6)}" fill="none" stroke="${p.col}" stroke-width="1" opacity=".35"/>`;
          s+=`<path d="${path(a+1e-6,L)}" fill="none" stroke="${p.col}" stroke-width="1" opacity=".35"/>`;
          s+=`<line x1="${X(a).toFixed(1)}" y1="${Y(-a/L).toFixed(1)}" x2="${X(a).toFixed(1)}" y2="${Y(b/L).toFixed(1)}" stroke="${p.col}" stroke-width="1" opacity=".35" stroke-dasharray="2,2"/>`;
        } else {
          s+=`<path d="${path(0,L)}" fill="none" stroke="${p.col}" stroke-width="1" opacity=".35"/>`;
        }
      }
      // traced portion 0..x
      if(p.k==='V' && x>a){
        s+=`<path d="${path(0,a-1e-6)}" fill="none" stroke="${p.col}" stroke-width="2.2"/>`;
        s+=`<line x1="${X(a).toFixed(1)}" y1="${Y(-a/L).toFixed(1)}" x2="${X(a).toFixed(1)}" y2="${Y(b/L).toFixed(1)}" stroke="${p.col}" stroke-width="2.2"/>`;
        s+=`<path d="${path(a+1e-6,x)}" fill="none" stroke="${p.col}" stroke-width="2.2"/>`;
      } else if(x>0){
        s+=`<path d="${path(0,Math.min(x,p.k==='V'?a-1e-6:x))}" fill="none" stroke="${p.col}" stroke-width="2.2"/>`;
      }
      // marker
      s+=`<line x1="${X(x).toFixed(1)}" y1="${Y(0).toFixed(1)}" x2="${X(x).toFixed(1)}" y2="${Y(p.f(x)).toFixed(1)}" stroke="${p.col}" stroke-width=".8" stroke-dasharray="2,2"/>`;
      s+=`<circle cx="${X(x).toFixed(1)}" cy="${Y(p.f(x)).toFixed(1)}" r="3.6" fill="${p.col}"/>`;
      s+=`<line x1="${X(a).toFixed(1)}" y1="${top+6}" x2="${X(a).toFixed(1)}" y2="${top+panelH-4}" stroke="var(--rust)" stroke-width=".6" stroke-dasharray="2,3"/>`;
      s+=`<text x="${padL}" y="${top+12}" font-size="8.5" fill="${p.col}">${p.lab}</text>`;
      s+=`<text x="${X(L)}" y="${Y(p.f(x))-6}" font-size="9" fill="${p.col}" text-anchor="end">${p.f(x).toFixed(3)}</text>`;
    });
    s+=`</svg>`;
    g('il-fig').innerHTML=s;
  }
  ['il-x','il-L','il-a','il-show','il-full'].forEach(id=>g(id).addEventListener('input',render));
  render();

  document.querySelectorAll('.quiz .q').forEach(q=>{
    const btns=q.querySelectorAll('button');
    btns.forEach(btn=>btn.addEventListener('click',()=>{
      if(q.classList.contains('answered'))return;
      q.classList.add('answered');
      btns.forEach(b=>{ if(b.dataset.v===q.dataset.a)b.classList.add('correct'); else if(b===btn)b.classList.add('wrong'); });
      const A=document.querySelectorAll('.quiz .q.answered').length;
      const R=document.querySelectorAll('.quiz .q.answered button.correct').length;
      g('quiz-score').textContent=R+' / '+A+' answered correctly so far';
    }));
  });
})();
</script>

</Base>
