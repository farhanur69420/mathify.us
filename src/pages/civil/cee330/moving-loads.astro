<!-- is:global is required: the .drow / .dhead / .gain / .loss rows below are injected
     via innerHTML at runtime, and Astro's scoped styles never reach those elements. -->
<style is:global>
  /* flex-grow only inside the horizontal .calc-pair row — as a direct child of the
     column-flex .calc-in, a grow factor would stretch the button down the panel */
  .mlbtn { font-family: 'Space Mono', monospace; font-size: .72rem; background: var(--surf2); border: 1px solid var(--bdr2); color: var(--txt2); border-radius: 6px; padding: .45rem .6rem; cursor: pointer; flex: 0 0 auto; }
  .calc-pair .mlbtn { flex: 1 1 0; }
  .mlbtn:hover { border-color: var(--teal); color: var(--teal); }
  .mlbtn-p { background: var(--tdim); border-color: var(--tline); color: var(--teal); width: 100%; }
  .drow { display: flex; justify-content: space-between; gap: .5rem; font-size: .78rem; padding: .25rem .7rem; color: var(--txt2); }
  .drow b { font-family: 'Space Mono', monospace; white-space: nowrap; }
  .dhead { font-family: 'Space Mono', monospace; font-size: .62rem; letter-spacing: .08em; text-transform: uppercase; color: var(--mut); padding: .5rem .7rem .1rem; }
  .gain b { color: var(--grn); } .loss b { color: var(--rust); }
</style>

<script is:inline>
(function(){
  const g=id=>document.getElementById(id);
  const P =[10,10,36,36,36,36,10,10,20,20,20,20,20,20];
  const SP=[5,8,6,6,6,8,4,9,4,4,12,4,4];
  const OF=[0]; SP.forEach(d=>OF.push(OF[OF.length-1]+d));
  const N=P.length, TL=OF[N-1], L=60, E=1e-7;
  const f2=n=>(Math.round(n*100)/100).toFixed(2);
  const on=x=>x>=-E&&x<=L+E;

  /* contribution of a UNIT load at x to the chosen function */
  function cont(x,c,m){
    if(!on(x))return 0;
    const ra=(L-x)/L;
    if(m==='R')return ra;
    if(m==='V')return ra-(x<c-E?1:0);
    return ra*c-(x<c-E?c-x:0);
  }
  const fv=(s,c,m)=>{let t=0;for(let i=0;i<N;i++)t+=P[i]*cont(s+OF[i],c,m);return t;};

  /* train positions at which some wheel sits on the critical point */
  const cands=(c,m)=>OF.map(o=>(m==='R'?0:c)-o).filter(v=>v>=-TL-E&&v<=L+E);

  /* exact breakpoints — the functions are piecewise linear between them */
  function samples(c){
    const a=[-TL,L];
    [0,L,c].forEach(k=>OF.forEach(o=>{const b=k-o; if(b>-TL&&b<L)a.push(b-1e-5,b+1e-5);}));
    return a.sort((p,q)=>p-q);
  }

  /* decompose the change over a move from s0 to s1 (s1 < s0) */
  function delta(s0,s1,c,m){
    const d=s0-s1; let shuf=0,onn=0,off=0,jump=0,SPs=0,Pl=0,e1=0,Pon=0,xo=0,Poff=0;
    for(let i=0;i<N;i++){
      const a=s0+OF[i], b=s1+OF[i], A=on(a), B=on(b);
      let j=0;
      if(m==='R'){ if(A&&!B){ j=-P[i]; Pl+=P[i]; } }
      else if(m==='V'){ if(A&&a>=c-E&&b<c-E){ j=-P[i]; Pl+=P[i]; } }
      const dc=P[i]*(cont(b,c,m)-cont(a,c,m))-j;
      jump+=j;
      if(A&&B){ shuf+=dc; SPs+=P[i]; }
      else if(!A&&B){ onn+=dc; Pon+=P[i]; e1+=P[i]*(L-b); }
      else if(A&&!B){ off+=dc; Poff+=P[i]; xo+=P[i]*a; }
    }
    return {d,shuf,onn,off,jump,SPs,Pl,Pon,e1,Poff,xo,net:shuf+onn+off+jump};
  }

  /* split of the load at the current position */
  function split(s,c){
    let W=0,Wl=0,Wr=0,at=0,atP=0;
    /* a load sitting exactly over A adds nothing to M at C and is about to leave
       the span, so it takes no part in the criterion — matches the textbook */
    for(let i=0;i<N;i++){const x=s+OF[i]; if(!on(x)||x<=1e-4)continue;
      W+=P[i];
      if(Math.abs(x-c)<1e-4){at=i+1;atP=P[i];Wr+=P[i];}
      else if(x<c)Wl+=P[i]; else Wr+=P[i];}
    return {W,Wl,Wr,at,atP};
  }
  const wheelAt=(s,m,c)=>{const k=m==='R'?0:c;
    for(let i=0;i<N;i++)if(Math.abs(s+OF[i]-k)<1e-4)return i+1; return 0;};

  const S=()=>+g('ml-s').value/10, C=()=>+g('ml-c').value, M=()=>g('ml-mode').value;
  const nm={R:'Reaction R<sub>A</sub>',V:'Shear V at the section',M:'Moment M at the section'};
  const un={R:'kips',V:'kips',M:'ft-kips'};

  function draw(){
    const s=S(), c=C(), m=M();
    g('ml-cv').textContent=c;
    const val=fv(s,c,m), cd=cands(c,m), sm=samples(c);
    let best=-Infinity,sBest=0;
    sm.forEach(t=>{const v=fv(t,c,m); if(v>best){best=v;sBest=t;}});
    const kw=wheelAt(s,m,c), bw=wheelAt(sBest,m,c), sp=split(s,c);

    /* ---------- figure ---------- */
    const W=360,pl=16,pr=14, x0=-30, x1=L+30;
    const X=ft=>pl+(ft-x0)/(x1-x0)*(W-pl-pr);
    const bY=52, tH=204;
    let v=`<svg viewBox="0 0 ${W} ${tH}" style="width:100%;height:auto">`;
    v+=`<defs><marker id="mlv" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="var(--teal)"/></marker></defs>`;
    /* section marker */
    if(m!=='R'){v+=`<line x1="${X(c)}" y1="14" x2="${X(c)}" y2="${bY+12}" stroke="var(--rust)" stroke-width="1" stroke-dasharray="3,3"/>`;
      v+=`<text x="${X(c)}" y="11" font-size="7.5" fill="var(--rust)" text-anchor="middle">section c = ${c} ft</text>`;}
    else {v+=`<line x1="${X(0)}" y1="14" x2="${X(0)}" y2="${bY+12}" stroke="var(--rust)" stroke-width="1" stroke-dasharray="3,3"/>`;
      v+=`<text x="${X(0)}" y="11" font-size="7.5" fill="var(--rust)" text-anchor="middle">support A</text>`;}
    /* beam + supports */
    v+=`<line x1="${X(0)}" y1="${bY}" x2="${X(L)}" y2="${bY}" stroke="var(--txt2)" stroke-width="2.2"/>`;
    [0,L].forEach(t=>{v+=`<polygon points="${X(t)},${bY} ${X(t)-6},${bY+9} ${X(t)+6},${bY+9}" fill="var(--bdr2)" stroke="var(--txt2)"/>`;});
    v+=`<text x="${X(0)}" y="${bY+20}" font-size="7.5" fill="var(--mut)" text-anchor="middle">A</text>`;
    v+=`<text x="${X(L)}" y="${bY+20}" font-size="7.5" fill="var(--mut)" text-anchor="middle">B  (L = ${L} ft)</text>`;
    /* wheels */
    for(let i=0;i<N;i++){
      const x=s+OF[i]; if(x<x0-2||x>x1+2)continue;
      const r=2.6+P[i]/14, live=on(x), crit=(i+1===kw);
      const col=crit?'var(--rust)':(live?'var(--teal)':'var(--mut)');
      v+=`<circle cx="${X(x)}" cy="${bY-r-1}" r="${r}" fill="${live?col:'none'}" fill-opacity="${crit?1:.35}" stroke="${col}" stroke-width="${crit?1.8:1}"/>`;
      if(live)v+=`<text x="${X(x)}" y="${bY-2*r-4}" font-size="5.6" fill="${col}" text-anchor="middle">${P[i]}</text>`;
    }
    v+=`<text x="${pl}" y="${bY+20}" font-size="7" fill="var(--amb)">&#9664; travel</text>`;
    /* ---------- sawtooth plot ---------- */
    const py0=100, py1=tH-12, mid=py1;
    const T=t=>pl+((L-t)/(L+TL))*(W-pl-pr);
    const sc=Math.max(best,1e-6), Yv=q=>py1-(q/sc)*(py1-py0-6);
    v+=`<line x1="${pl}" y1="${mid}" x2="${W-pr}" y2="${mid}" stroke="var(--bdr2)" stroke-width="1"/>`;
    let p='';
    sm.forEach((t,i)=>{p+=(i?' L ':'M ')+T(t).toFixed(1)+' '+Yv(fv(t,c,m)).toFixed(1);});
    v+=`<path d="${p}" fill="none" stroke="var(--teal)" stroke-width="1.9"/>`;
    v+=`<line x1="${T(sBest)}" y1="${mid}" x2="${T(sBest)}" y2="${Yv(best)}" stroke="var(--amb)" stroke-width=".8" stroke-dasharray="2,2"/>`;
    v+=`<circle cx="${T(sBest)}" cy="${Yv(best)}" r="3" fill="var(--amb)"/>`;
    v+=`<text x="${T(sBest)}" y="${Yv(best)-6}" font-size="7.5" fill="var(--amb)" text-anchor="middle">max ${f2(best)}</text>`;
    v+=`<circle cx="${T(s)}" cy="${Yv(val)}" r="3.4" fill="var(--rust)"/>`;
    v+=`<text x="${pl}" y="${py0-10}" font-size="7.5" fill="var(--txt2)">${nm[m].replace(/<[^>]+>/g,'')} vs train position &rarr;</text>`;
    v+=`</svg>`;
    g('ml-fig').innerHTML=v;

    /* ---------- results ---------- */
    let h=`<div class="res"><span>Wheel on the critical point</span><b>${kw?('wheel '+kw):'&mdash; (between wheels)'}</b></div>`;
    h+=`<div class="res"><span>R<sub>A</sub> right now</span><b>${f2(fv(s,c,'R'))} k</b></div>`;
    h+=`<div class="res"><span>${nm[m]}</span><b>${f2(val)} ${un[m]}</b></div>`;

    if(m==='M'){
      const a=c,b=L-c, WL=sp.W/L;
      const lo=sp.Wl/a, hi=(sp.Wl+sp.atP)/a;
      const ok=sp.at&&lo<WL+1e-9&&hi>WL-1e-9;
      h+=`<div class="dhead">Criterion &nbsp; W&#8321;/a = W&#8322;/b = W/L</div>`;
      h+=`<div class="drow"><span>On span W &middot; left W&#8321; &middot; right W&#8322;</span><b>${sp.W} / ${sp.Wl} / ${sp.Wr} k</b></div>`;
      h+=`<div class="drow"><span>Span average W/L</span><b>${f2(WL)} k/ft</b></div>`;
      if(sp.at){
        h+=`<div class="drow ${lo<WL?'gain':'loss'}"><span>Wheel ${sp.at} counted right &rarr; W&#8321;/a</span><b>${f2(lo)} ${lo<WL?'&lt;':'&gt;'} ${f2(WL)} ${lo<WL?'&#10003;':'&#10007;'}</b></div>`;
        h+=`<div class="drow ${hi>WL?'gain':'loss'}"><span>Wheel ${sp.at} counted left &rarr; W&#8321;/a</span><b>${f2(hi)} ${hi>WL?'&gt;':'&lt;'} ${f2(WL)} ${hi>WL?'&#10003;':'&#10007;'}</b></div>`;
        h+=`<div class="verdict ${ok?'v-pass':'v-fail'}"><span>Wheel ${sp.at} at the section</span><b>${ok?'satisfies the criterion':'does not satisfy it'}</b></div>`;
      } else h+=`<div class="drow"><span>No wheel at the section</span><b>step to a candidate</b></div>`;
    } else {
      const nx=cd.filter(t=>t<s-1e-6).sort((p,q)=>q-p)[0];
      h+=`<div class="dhead">Next move &nbsp; &Delta;${m} = &Sigma;Pd&#8321;/L + P&prime;e/L &minus; P&#8321;</div>`;
      if(nx===undefined) h+=`<div class="drow"><span>The train has run out of span</span><b>&mdash;</b></div>`;
      else{
        const D=delta(s,nx,c,m);
        h+=`<div class="drow gain"><span>&Sigma;P = ${D.SPs}<sup>k</sup> creeping d&#8321; = ${f2(D.d)} ft closer</span><b>+${f2(D.shuf)}</b></div>`;
        if(Math.abs(D.onn)>1e-6)h+=`<div class="drow gain"><span>${D.Pon}<sup>k</sup> rolling on at B (P&prime;e/L)</span><b>+${f2(D.onn)}</b></div>`;
        if(Math.abs(D.off)>1e-6)h+=`<div class="drow ${D.off>=0?'gain':'loss'}"><span>${D.Poff}<sup>k</sup> running off at A</span><b>${D.off>=0?'+':''}${f2(D.off)}</b></div>`;
        if(Math.abs(D.jump)>1e-6)h+=`<div class="drow loss"><span>P&#8321; = ${D.Pl}<sup>k</sup> ${m==='R'?'leaving the span':'passing the section'}</span><b>${f2(D.jump)}</b></div>`;
        h+=`<div class="verdict ${D.net>0?'v-pass':'v-fail'}"><span>Net &Delta;${m} &rarr; ${D.net>0?'make the move':'STOP &mdash; you are at the peak'}</span><b>${D.net>0?'+':''}${f2(D.net)}</b></div>`;
      }
    }
    h+=`<div class="res"><span>True maximum over the traverse</span><b>${f2(best)} ${un[m]}${bw?' (wheel '+bw+')':''}</b></div>`;
    g('ml-res').innerHTML=h;
  }

  function goto(t){g('ml-s').value=Math.round(t*10);draw();}
  g('ml-step').onclick=()=>{const s=S(),c=cands(C(),M()).filter(t=>t<S()-1e-6).sort((p,q)=>q-p)[0];if(c!==undefined)goto(c);};
  g('ml-back').onclick=()=>{const c=cands(C(),M()).filter(t=>t>S()+1e-6).sort((p,q)=>p-q)[0];if(c!==undefined)goto(c);};
  g('ml-max').onclick=()=>{const c=C(),m=M();let b=-Infinity,sb=0;
    samples(c).forEach(t=>{const v=fv(t,c,m);if(v>b){b=v;sb=t;}});
    const nr=cands(c,m).sort((p,q)=>Math.abs(p-sb)-Math.abs(q-sb))[0];
    goto(Math.abs(nr-sb)<0.02?nr:sb);};
  ['ml-mode','ml-c','ml-s'].forEach(id=>g(id).addEventListener('input',draw));
  g('ml-mode').addEventListener('change',()=>goto(M()==='R'?0:C()));
  goto(0);

  document.querySelectorAll('.quiz .q').forEach(q=>{
    const b=q.querySelectorAll('button');
    b.forEach(btn=>btn.addEventListener('click',()=>{
      if(q.classList.contains('answered'))return;
      q.classList.add('answered');
      b.forEach(x=>{if(x.dataset.v===q.dataset.a)x.classList.add('correct');else if(x===btn)x.classList.add('wrong');});
      const A=document.querySelectorAll('.quiz .q.answered').length;
      const R=document.querySelectorAll('.quiz .q.answered button.correct').length;
      g('quiz-score').textContent=R+' / '+A+' answered correctly so far';
    }));
  });
})();
</script>

</Base>
