<script is:inline>
function lpDraw(){
  const mode = document.getElementById('lp-mode').value;
  const phi = +document.getElementById('lp-phi').value;
  document.getElementById('lp-phi-v').textContent = phi + '°';
  const g = +document.getElementById('lp-g').value;
  const gsat = +document.getElementById('lp-gsat').value;
  const H = +document.getElementById('lp-h').value;
  const zw = Math.min(+document.getElementById('lp-zw').value, H);
  const gw = 9.81;
  const phir = phi * Math.PI/180;
  let K, label;
  if(mode==='0'){ K = 1 - Math.sin(phir); label = 'K₀'; }
  else if(mode==='a'){ K = Math.pow(Math.tan(Math.PI/4 - phir/2), 2); label = 'Kₐ'; }
  else { K = Math.pow(Math.tan(Math.PI/4 + phir/2), 2); label = 'Kₚ'; }

  const gsub = gsat - gw;
  function sigV(z){ return z<=zw ? g*z : g*zw + gsub*(z-zw); }
  function u(z){ return z<=zw ? 0 : gw*(z-zw); }
  function sigH(z){ return K*sigV(z) + u(z); }

  const breaks = zw>0 && zw<H ? [0, zw, H] : [0, H];
  const pts = breaks.map(z => ({z, p: sigH(z)}));

  let P = 0, M = 0;
  for(let i=0;i<pts.length-1;i++){
    const z1=pts[i].z, z2=pts[i+1].z, p1=pts[i].p, p2=pts[i+1].p;
    const dz = z2-z1;
    const area = 0.5*(p1+p2)*dz;
    const centroidFromTop = dz===0?z1:(z1*(2*p1+p2) + z2*(p1+2*p2))/(3*(p1+p2||1));
    P += area; M += area*centroidFromTop;
  }
  const zbarTop = P>0 ? M/P : 0;
  const zbarFromBase = H - zbarTop;

  const maxP = Math.max(...pts.map(pt=>pt.p), 1);
  const W = 260, Hpx = 220, x0 = 40, scale = 150/maxP;
  const yOf = z => 20 + (z/H)*180;
  const xOf = p => x0 + p*scale;
  let poly = `${x0},20 `;
  pts.forEach(pt => poly += `${xOf(pt.p)},${yOf(pt.z)} `);
  poly += `${x0},200`;

  let wtLine = '';
  if(zw>0 && zw<H){
    wtLine = `<line x1="10" y1="${yOf(zw)}" x2="${W-10}" y2="${yOf(zw)}" stroke="#4a9fe0" stroke-dasharray="4,3" stroke-width="1.2"/><text x="${W-10}" y="${yOf(zw)-4}" font-size="9" fill="#4a9fe0" text-anchor="end">GWT</text>`;
  }

  document.getElementById('lp-diagram').innerHTML = `
  <svg viewBox="0 0 ${W} ${Hpx}" class="calc-svg">
    <line x1="${x0}" y1="20" x2="${x0}" y2="200" stroke="var(--bdr2)" stroke-width="1.5"/>
    <line x1="10" y1="20" x2="10" y2="200" stroke="var(--bdr)" stroke-width="3"/>
    ${wtLine}
    <polygon points="${poly}" fill="rgba(78,201,176,0.18)" stroke="var(--teal)" stroke-width="1.5"/>
    <text x="${x0}" y="14" font-size="9" fill="var(--txt2)" text-anchor="middle">0</text>
    <text x="${xOf(pts[pts.length-1].p)}" y="212" font-size="9" fill="var(--teal)" text-anchor="middle">${pts[pts.length-1].p.toFixed(1)} kPa</text>
    <text x="20" y="212" font-size="9" fill="var(--txt2)">H=${H}m</text>
  </svg>`;

  document.getElementById('lp-results').innerHTML = `
    <div class="res"><span>${label}</span><b>${K.toFixed(3)}</b></div>
    <div class="res"><span>&sigma;<sub>h</sub> at base</span><b>${pts[pts.length-1].p.toFixed(1)} kPa</b></div>
    <div class="res"><span>Resultant P</span><b>${P.toFixed(1)} kN/m</b></div>
    <div class="res"><span>Acts above base</span><b>${zbarFromBase.toFixed(2)} m</b></div>
  `;
}
['lp-mode','lp-phi','lp-g','lp-gsat','lp-h','lp-zw'].forEach(id=>{
  document.getElementById(id).addEventListener('input', lpDraw);
});
lpDraw();

document.querySelectorAll('.quiz .q').forEach(q=>{
  const buttons = q.querySelectorAll('button');
  buttons.forEach(btn=>{
    btn.addEventListener('click', ()=>{
      if(q.classList.contains('answered')) return;
      q.classList.add('answered');
      const correct = q.dataset.a;
      buttons.forEach(b=>{
        if(b.dataset.v===correct) b.classList.add('correct');
        else if(b===btn) b.classList.add('wrong');
      });
      const answered = document.querySelectorAll('.quiz .q.answered').length;
      const right = document.querySelectorAll('.quiz .q.answered button.correct').length;
      document.getElementById('quiz-score').textContent = `${right} / ${answered} answered correctly so far`;
    });
  });
});
</script>

</Base>
