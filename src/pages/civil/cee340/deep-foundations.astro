<script is:inline>
(function(){
  const g=id=>document.getElementById(id), v=id=>+g(id).value;
  const R=Math.PI/180;
  // Meyerhof's Nq* for piles (Das) — far larger than the shallow-foundation Nq.
  const NQ={20:12.4,21:13.8,22:15.5,23:17.9,24:21.4,25:26.0,26:29.5,27:34.0,28:39.7,
    29:46.5,30:56.7,31:68.2,32:81.0,33:96.0,34:115.0,35:143.0,36:168.0,37:194.0,
    38:231.0,39:276.0,40:346.0,41:420.0,42:525.0,43:650.0,44:780.0,45:930.0};
  function NqStar(phi){
    if(phi<=20) return 12.4;
    if(phi>=45) return 930;
    const lo=Math.floor(phi), hi=lo+1, t=phi-lo;
    return NQ[lo]+(NQ[hi]-NQ[lo])*t;
  }

  function pile(){
    const sand=g('pl-soil').value==='sand';
    const circle=g('pl-shape').value==='circle';
    const D=v('pl-d'), L=v('pl-l'), gam=v('pl-g'), FS=Math.max(1,v('pl-fs'));
    g('pl-row-phi').style.display = sand?'block':'none';
    g('pl-row-cu').style.display  = sand?'none':'block';
    if(D<=0||L<=0){ g('pl-res').innerHTML='<div class="verdict v-fail"><span>Check inputs</span></div>'; return; }

    const Ap = circle ? Math.PI*D*D/4 : D*D;
    const per = circle ? Math.PI*D : 4*D;
    let Qp, Qs, extra='', Lc=null, limited=false;

    if (sand){
      const phi=v('pl-phi'), K=v('pl-k'), d=0.7*phi*R;
      Lc = 15*D;
      const qEff = gam*Math.min(L,Lc);
      const Nq = NqStar(phi);
      const Qraw = Ap*qEff*Nq;
      const Qlim = Ap*0.5*100*Nq*Math.tan(phi*R);
      limited = Qlim < Qraw;
      Qp = Math.min(Qraw,Qlim);
      const La=Math.min(L,Lc), Lb=Math.max(0,L-Lc);
      const Qs1=K*(gam*La/2)*Math.tan(d)*per*La;
      const Qs2=K*(gam*Lc)*Math.tan(d)*per*Lb;
      Qs=Qs1+Qs2;
      extra = `<div class="res"><span>N<sub>q</sub>* / critical depth</span><b>${Nq.toFixed(0)} / ${Lc.toFixed(1)} m</b></div>`+
        `<div class="res"><span>&sigma;'<sub>v</sub> at tip (capped)</span><b>${qEff.toFixed(0)} kPa</b></div>`+
        (limited?`<div class="verdict v-fail"><span>Meyerhof limit governs Q<sub>p</sub></span><b>${Qraw.toFixed(0)}&rarr;${Qlim.toFixed(0)} kN</b></div>`:'');
    } else {
      const cu=v('pl-cu'), al=v('pl-alpha');
      Qp = 9*cu*Ap;
      Qs = al*cu*per*L;
      extra = `<div class="res"><span>N<sub>c</sub>* / &alpha;</span><b>9 / ${al}</b></div>`;
    }

    const Qu=Qp+Qs, Qall=Qu/FS, share=100*Qs/Qu;
    g('pl-res').innerHTML = extra +
      `<div class="res"><span>End bearing Q<sub>p</sub></span><b>${Qp.toFixed(0)} kN (${(100-share).toFixed(0)}%)</b></div>`+
      `<div class="res"><span>Skin friction Q<sub>s</sub></span><b>${Qs.toFixed(0)} kN (${share.toFixed(0)}%)</b></div>`+
      `<div class="verdict v-pass"><span>Ultimate Q<sub>u</sub></span><b>${Qu.toFixed(0)} kN</b></div>`+
      `<div class="verdict v-pass"><span>Allowable (FS=${FS})</span><b>${Qall.toFixed(0)} kN</b></div>`+
      `<div class="res"><span>Behaves as</span><b>${share>70?'friction pile':share<40?'end-bearing pile':'combination'}</b></div>`;

    // figure: pile with proportional Qp / Qs bars.
    // Labels are anchored to distinct zones (top-left, mid-right, bottom) because
    // L/2 and L_c frequently coincide and would otherwise overprint each other.
    const W=290,Hh=205,gl=30,px=112;
    const sc=Math.min(132/Math.max(L,1),24);
    const plen=L*sc, pw=Math.max(9,Math.min(22,D*sc*1.6));
    const barW=Math.max(4,(Qs/Qu)*54), tipW=Math.max(6,(Qp/Qu)*54);
    const barTop=gl+plen*0.18, barH=plen*0.64;
    let lcLine='';
    if(Lc!==null && Lc<L){
      const y=gl+Lc*sc;
      lcLine=`<line x1="26" y1="${y.toFixed(1)}" x2="${(px-pw/2-4).toFixed(1)}" y2="${y.toFixed(1)}" stroke="var(--vio)" stroke-width="1" stroke-dasharray="4,3"/>`+
             `<text x="28" y="${(y-4).toFixed(1)}" font-size="8" fill="var(--vio)">L_c = ${Lc.toFixed(1)} m</text>`;
    }
    g('pl-fig').innerHTML=`
    <svg viewBox="0 0 ${W} ${Hh}" style="width:100%;height:auto">
      <rect x="20" y="${gl}" width="${W-38}" height="${Hh-gl-16}" fill="rgba(212,169,74,0.05)"/>
      <line x1="20" y1="${gl}" x2="${W-18}" y2="${gl}" stroke="var(--bdr2)" stroke-width="1.2"/>
      ${lcLine}
      <rect x="${(px-pw/2).toFixed(1)}" y="${gl}" width="${pw.toFixed(1)}" height="${plen.toFixed(1)}" fill="var(--surf3)" stroke="var(--teal)" stroke-width="1.4"/>
      <text x="${(px-pw/2-5).toFixed(1)}" y="${(gl+11).toFixed(1)}" font-size="8" fill="var(--teal)" text-anchor="end">L = ${L} m</text>
      <rect x="${(px+pw/2+5).toFixed(1)}" y="${barTop.toFixed(1)}" width="${barW.toFixed(1)}" height="${barH.toFixed(1)}" fill="rgba(212,169,74,0.35)" stroke="var(--amb)"/>
      <text x="${(px+pw/2+9+barW).toFixed(1)}" y="${(barTop+11).toFixed(1)}" font-size="8" fill="var(--amb)">Q&#8202;s ${(Qs/Qu*100).toFixed(0)}%</text>
      <rect x="${(px-tipW/2).toFixed(1)}" y="${(gl+plen+3).toFixed(1)}" width="${tipW.toFixed(1)}" height="8" fill="rgba(194,90,59,0.4)" stroke="var(--rust)"/>
      <text x="${px}" y="${(gl+plen+24).toFixed(1)}" font-size="8" fill="var(--rust)" text-anchor="middle">Q&#8202;p ${(Qp/Qu*100).toFixed(0)}%</text>
    </svg>`;
  }
  ['pl-soil','pl-shape','pl-d','pl-l','pl-g','pl-phi','pl-k','pl-cu','pl-alpha','pl-fs'].forEach(id=>g(id).addEventListener('input',pile));
  pile();

  document.querySelectorAll('.quiz .q').forEach(q=>{
    const btns=q.querySelectorAll('button');
    btns.forEach(btn=>btn.addEventListener('click',()=>{
      if(q.classList.contains('answered'))return;
      q.classList.add('answered');
      btns.forEach(b=>{ if(b.dataset.v===q.dataset.a)b.classList.add('correct'); else if(b===btn)b.classList.add('wrong'); });
      const a=document.querySelectorAll('.quiz .q.answered').length;
      const r=document.querySelectorAll('.quiz .q.answered button.correct').length;
      g('quiz-score').textContent=r+' / '+a+' answered correctly so far';
    }));
  });
})();
</script>

