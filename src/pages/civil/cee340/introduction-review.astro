<script is:inline>
(function(){
  const g=id=>document.getElementById(id), v=id=>+g(id).value;
  const GW=9.81;

  /* ── phase relations ── */
  function phase(){
    const Gs=v('ph-gs'), w=v('ph-w'), e=v('ph-e');
    if(Gs<=0||e<=0||w<0){ g('ph-res').innerHTML='<div class="verdict v-fail"><span>Check inputs</span></div>'; return; }
    const n=e/(1+e), S=Gs*w/e;
    const gd=Gs*GW/(1+e), gm=gd*(1+w), gsat=(Gs+e)*GW/(1+e), gsub=gsat-GW;
    const over = S>1.0001;
    g('ph-res').innerHTML =
      `<div class="res"><span>Porosity n</span><b>${n.toFixed(3)}</b></div>`+
      `<div class="${over?'verdict v-fail':'res'}"><span>Degree of saturation S</span><b>${(S*100).toFixed(1)}%${over?' — impossible, S>100%':''}</b></div>`+
      `<div class="res"><span>Dry &gamma;<sub>d</sub></span><b>${gd.toFixed(2)} kN/m&sup3;</b></div>`+
      `<div class="res"><span>Moist &gamma;</span><b>${gm.toFixed(2)} kN/m&sup3;</b></div>`+
      `<div class="res"><span>Saturated &gamma;<sub>sat</sub></span><b>${gsat.toFixed(2)} kN/m&sup3;</b></div>`+
      `<div class="verdict v-pass"><span>Submerged &gamma;'</span><b>${gsub.toFixed(2)} kN/m&sup3; (${(100*gsub/gsat).toFixed(0)}% of &gamma;<sub>sat</sub>)</b></div>`;

    // three-phase block diagram, heights proportional to volume
    const Vs=1, Vv=e, Vw=Math.min(Vv, S*Vv), Va=Math.max(0,Vv-Vw), tot=Vs+Vv;
    const W=250,H=170,x=70,bw=95,top=18,bh=126;
    const hA=bh*Va/tot, hW=bh*Vw/tot, hS=bh*Vs/tot;
    g('ph-fig').innerHTML=`
    <svg viewBox="0 0 ${W} ${H}" style="width:100%;height:auto">
      <rect x="${x}" y="${top}" width="${bw}" height="${hA.toFixed(1)}" fill="rgba(140,150,170,.18)" stroke="var(--bdr2)"/>
      <rect x="${x}" y="${(top+hA).toFixed(1)}" width="${bw}" height="${hW.toFixed(1)}" fill="rgba(74,159,224,.30)" stroke="#4a9fe0"/>
      <rect x="${x}" y="${(top+hA+hW).toFixed(1)}" width="${bw}" height="${hS.toFixed(1)}" fill="rgba(212,169,74,.28)" stroke="var(--amb)"/>
      ${hA>9?`<text x="${x+bw/2}" y="${(top+hA/2+3).toFixed(1)}" font-size="9" fill="var(--txt2)" text-anchor="middle">air</text>`:''}
      ${hW>9?`<text x="${x+bw/2}" y="${(top+hA+hW/2+3).toFixed(1)}" font-size="9" fill="#4a9fe0" text-anchor="middle">water</text>`:''}
      <text x="${x+bw/2}" y="${(top+hA+hW+hS/2+3).toFixed(1)}" font-size="9" fill="var(--amb)" text-anchor="middle">solids</text>
      <line x1="${x-8}" y1="${top}" x2="${x-8}" y2="${(top+hA+hW).toFixed(1)}" stroke="var(--mut)"/>
      <text x="${x-11}" y="${(top+(hA+hW)/2).toFixed(1)}" font-size="8" fill="var(--mut)" text-anchor="end">V&#8341; = e</text>
      <line x1="${x+bw+8}" y1="${(top+hA+hW).toFixed(1)}" x2="${x+bw+8}" y2="${(top+bh).toFixed(1)}" stroke="var(--mut)"/>
      <text x="${x+bw+11}" y="${(top+hA+hW+hS/2).toFixed(1)}" font-size="8" fill="var(--mut)">V&#8347; = 1</text>
      <text x="${W/2}" y="${H-6}" font-size="8.5" fill="var(--txt2)" text-anchor="middle">phase volumes (per unit solid)</text>
    </svg>`;
  }
  ['ph-gs','ph-w','ph-e'].forEach(id=>g(id).addEventListener('input',phase));
  phase();

  /* ── effective stress profile ── */
  function effstress(){
    const h1=v('es-h1'), g1=v('es-g1'), g1s=v('es-g1s');
    const h2=v('es-h2'), g2=v('es-g2'), g2s=v('es-g2s');
    const H=h1+h2;
    const dw=Math.min(H, v('es-dw')/10);
    g('es-dw-v').textContent=dw.toFixed(1);
    const z=Math.min(Math.max(0,v('es-z')), H);
    if(h1<0||h2<=0){ g('es-res').innerHTML='<div class="verdict v-fail"><span>Check layer thicknesses</span></div>'; return; }

    // Unit weight depends on BOTH which layer we are in and whether we are
    // below the water table — hence four inputs, not two.
    const gammaAt = d => (d < h1) ? (d < dw ? g1 : g1s) : (d < dw ? g2 : g2s);

    // Exact piecewise integration: the only breaks are the layer boundary and
    // the water table, so integrate segment by segment instead of stepping.
    function sig(zz){
      const brk=[0,h1,dw,zz].filter(b=>b>=0&&b<=zz).sort((a,b)=>a-b);
      let s=0;
      for(let i=0;i<brk.length-1;i++){
        const a=brk[i], b=brk[i+1];
        if(b-a<=0) continue;
        s += gammaAt((a+b)/2)*(b-a);
      }
      return s;
    }
    const u=zz=>zz>dw?GW*(zz-dw):0;
    const N=60, pts=[];
    for(let i=0;i<=N;i++){ const zz=H*i/N; const S=sig(zz); pts.push({z:zz,s:S,u:u(zz),e:S-u(zz)}); }
    const at={z, s:sig(z), u:u(z)}; at.e=at.s-at.u;

    g('es-res').innerHTML =
      `<div class="res"><span>Water table</span><b>${dw.toFixed(2)} m deep</b></div>`+
      `<div class="res"><span>Total &sigma; at ${z} m</span><b>${at.s.toFixed(1)} kPa</b></div>`+
      `<div class="res"><span>Pore pressure u</span><b>${at.u.toFixed(1)} kPa</b></div>`+
      `<div class="verdict v-pass"><span>Effective &sigma;' at ${z} m</span><b>${at.e.toFixed(1)} kPa</b></div>`+
      `<div class="res"><span>Water carries</span><b>${at.s>0?(100*at.u/at.s).toFixed(0):0}% of total</b></div>`;

    const W=300,Hh=190,x0=42,y0=158,xr=225,yr=132;
    const mx=Math.max(...pts.map(p=>p.s),1);
    const PX=s=>x0+(s/mx)*xr, PY=zz=>(y0-yr)+(zz/H)*yr;
    const path=k=>pts.map((p,i)=>(i?'L ':'M ')+PX(p[k]).toFixed(1)+' '+PY(p.z).toFixed(1)).join(' ');
    const wtY=PY(dw);
    g('es-fig').innerHTML=`
    <svg viewBox="0 0 ${W} ${Hh}" style="width:100%;height:auto">
      <line x1="${x0}" y1="${y0-yr}" x2="${x0}" y2="${y0}" stroke="var(--bdr2)"/>
      <line x1="${x0}" y1="${y0-yr}" x2="${x0+xr+8}" y2="${y0-yr}" stroke="var(--bdr2)"/>
      ${h1>0&&h1<H?`<line x1="${x0}" y1="${PY(h1).toFixed(1)}" x2="${x0+xr}" y2="${PY(h1).toFixed(1)}" stroke="var(--bdr)" stroke-dasharray="2,3"/>`:''}
      <line x1="${x0}" y1="${wtY.toFixed(1)}" x2="${x0+xr}" y2="${wtY.toFixed(1)}" stroke="#4a9fe0" stroke-width="1.2" stroke-dasharray="5,3"/>
      <text x="${x0+xr+6}" y="${(wtY+3).toFixed(1)}" font-size="8" fill="#4a9fe0">WT</text>
      <path d="${path('s')}" fill="none" stroke="var(--txt2)" stroke-width="1.7"/>
      <path d="${path('u')}" fill="none" stroke="#4a9fe0" stroke-width="1.7"/>
      <path d="${path('e')}" fill="none" stroke="var(--teal)" stroke-width="2.1"/>
      <line x1="${x0}" y1="${PY(z).toFixed(1)}" x2="${PX(at.s).toFixed(1)}" y2="${PY(z).toFixed(1)}" stroke="var(--amb)" stroke-width=".8" stroke-dasharray="3,2"/>
      <circle cx="${PX(at.e).toFixed(1)}" cy="${PY(z).toFixed(1)}" r="3" fill="var(--teal)"/>
      <text x="${x0-4}" y="${(y0-yr+4).toFixed(1)}" font-size="8" fill="var(--mut)" text-anchor="end">0</text>
      <text x="${x0-4}" y="${(y0+3).toFixed(1)}" font-size="8" fill="var(--mut)" text-anchor="end">${H}m</text>
      <text x="${x0+6}" y="${(y0-yr-4).toFixed(1)}" font-size="8" fill="var(--txt2)">σ</text>
      <text x="${x0+34}" y="${(y0-yr-4).toFixed(1)}" font-size="8" fill="var(--teal)">σ'</text>
      <text x="${x0+62}" y="${(y0-yr-4).toFixed(1)}" font-size="8" fill="#4a9fe0">u</text>
      <text x="${x0+xr/2}" y="${Hh-3}" font-size="8.5" fill="var(--txt2)" text-anchor="middle">stress (kPa) →</text>
    </svg>`;
  }
  ['es-h1','es-g1','es-g1s','es-h2','es-g2','es-g2s','es-dw','es-z'].forEach(id=>g(id).addEventListener('input',effstress));
  effstress();

  document.querySelectorAll('.quiz .q').forEach(q=>{
    const btns=q.querySelectorAll('button');
    btns.forEach(btn=>btn.addEventListener('click',()=>{
      if(q.classList.contains('answered'))return;
      q.classList.add('answered');
      btns.forEach(b=>{ if(b.dataset.v===q.dataset.a)b.classList.add('correct'); else if(b===btn)b.classList.add('wrong'); });
      const a=document.querySelectorAll('.quiz .q.answered').length;
      const r=document.querySelectorAll('.quiz .q.answered button.correct').length;
      g('quiz-score').textContent=r+' / '+a+' answered correctly so far';
    }));
  });
})();
</script>

</Base>
