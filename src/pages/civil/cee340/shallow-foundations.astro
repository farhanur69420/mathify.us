  <a href="/civil/cee340/soil-investigation">&larr; Soil Investigation</a>
  <a href="/civil/cee340/deep-foundations">Next: Deep Foundations &rarr;</a>
</footer>

<script is:inline>
(function(){
  const g=id=>document.getElementById(id), v=id=>+g(id).value;
  const GW=9.81, R=Math.PI/180;

  function factors(phi){
    if(phi<=0) return {Nc:5.14,Nq:1,Ng:0};
    const p=phi*R;
    const Nq=Math.exp(Math.PI*Math.tan(p))*Math.pow(Math.tan((45+phi/2)*R),2);
    return {Nc:(Nq-1)/Math.tan(p), Nq, Ng:2*(Nq+1)*Math.tan(p)};
  }

  function bearing(){
    const shape=g('bc-shape').value;
    let B=v('bc-b'), L=shape==='strip'?1e6:(shape==='circle'?v('bc-b'):v('bc-l'));
    const Df=v('bc-df'), c=v('bc-c'), phi=v('bc-phi');
    const gm=v('bc-g'), gsat=v('bc-gsat'), dw=v('bc-dw'), FS=Math.max(1,v('bc-fs'));
    if(B<=0||Df<0){ g('bc-res').innerHTML='<div class="verdict v-fail"><span>Check inputs</span></div>'; return; }
    const gsub=gsat-GW;
    const {Nc,Nq,Ng}=factors(phi);
    const BL = shape==='strip'?0:B/L;

    // water table cases
    let q, gEff, kase;
    if (dw <= Df){                       // Case I — water above footing base
      q = dw*gm + (Df-dw)*gsub; gEff = gsub; kase='Case I — water above base';
    } else if (dw < Df + B){             // Case II — within B below base
      const d = dw - Df;
      q = gm*Df; gEff = gsub + (d/B)*(gm-gsub); kase='Case II — within B below base';
    } else {                             // Case III — deep
      q = gm*Df; gEff = gm; kase='Case III — no water table effect';
    }

    const p=phi*R;
    const Fcs = phi>0 ? 1+BL*(Nq/Nc) : 1+0.2*BL;
    const Fqs = 1+BL*Math.tan(p);
    const Fgs = 1-0.4*BL;
    const k = Df/B;
    const Fqd = phi>0 ? 1+2*Math.tan(p)*Math.pow(1-Math.sin(p),2)*k : 1;
    const Fcd = phi>0 ? Fqd-(1-Fqd)/(Nc*Math.tan(p)) : 1+0.4*k;
    const Fgd = 1;

    const t1=c*Nc*Fcs*Fcd, t2=q*Nq*Fqs*Fqd, t3=0.5*gEff*B*Ng*Fgs*Fgd;
    const qu=t1+t2+t3, qnet=qu-q, qall=qnet/FS;
    const area = shape==='strip' ? B : (shape==='circle' ? Math.PI*B*B/4 : B*L);
    const Qall = qall*area;

    const pct = x => (100*x/qu).toFixed(0)+'%';
    g('bc-res').innerHTML=
      `<div class="verdict ${dw>=Df+B?'v-pass':'v-fail'}"><span>${kase}</span><b>&gamma;<sub>eff</sub> ${gEff.toFixed(2)}</b></div>`+
      `<div class="res"><span>N<sub>c</sub> / N<sub>q</sub> / N<sub>&gamma;</sub></span><b>${Nc.toFixed(1)} / ${Nq.toFixed(1)} / ${Ng.toFixed(1)}</b></div>`+
      `<div class="res"><span>Surcharge q</span><b>${q.toFixed(1)} kPa</b></div>`+
      `<div class="res"><span>cohesion / surcharge / weight</span><b>${pct(t1)} / ${pct(t2)} / ${pct(t3)}</b></div>`+
      `<div class="res"><span>Ultimate q<sub>u</sub></span><b>${qu.toFixed(0)} kPa</b></div>`+
      `<div class="res"><span>Net ultimate</span><b>${qnet.toFixed(0)} kPa</b></div>`+
      `<div class="verdict v-pass"><span>Allowable q<sub>all(net)</sub> (FS=${FS})</span><b>${qall.toFixed(0)} kPa</b></div>`+
      `<div class="verdict v-pass"><span>Allowable load Q<sub>all</sub></span><b>${Qall.toFixed(0)} kN${shape==='strip'?'/m':''}</b></div>`;

    // figure: footing + water table + term contributions
    const W=300,Hh=175, gl=48, sc=Math.min(150/Math.max(B,0.5), 46/Math.max(Df,0.4), 34);
    const cx=150, bw=B*sc, bd=Df*sc;
    const wy = dw>=Df+B ? null : gl + Math.min(dw,Df+B)*sc;
    g('bc-fig').innerHTML=`
    <svg viewBox="0 0 ${W} ${Hh}" style="width:100%;height:auto">
      <rect x="10" y="${gl}" width="${W-20}" height="${Hh-gl-28}" fill="rgba(212,169,74,0.06)"/>
      <line x1="10" y1="${gl}" x2="${W-20}" y2="${gl}" stroke="var(--bdr2)" stroke-width="1.3"/>
      ${wy!==null?`<line x1="10" y1="${wy.toFixed(1)}" x2="${W-20}" y2="${wy.toFixed(1)}" stroke="#4a9fe0" stroke-width="1.3" stroke-dasharray="5,3"/><text x="${W-22}" y="${(wy-4).toFixed(1)}" font-size="8" fill="#4a9fe0" text-anchor="end">GWT ${dw} m</text>`:`<text x="${W-22}" y="${Hh-8}" font-size="8" fill="#4a9fe0" text-anchor="end">GWT below failure zone</text>`}
      <rect x="${(cx-bw/2).toFixed(1)}" y="${(gl+bd).toFixed(1)}" width="${bw.toFixed(1)}" height="12" fill="var(--surf3)" stroke="var(--teal)" stroke-width="1.3"/>
      <line x1="${cx}" y1="${gl-26}" x2="${cx}" y2="${(gl+bd-2).toFixed(1)}" stroke="var(--teal)" stroke-width="6"/>
      <line x1="${(cx-bw/2-8).toFixed(1)}" y1="${gl}" x2="${(cx-bw/2-8).toFixed(1)}" y2="${(gl+bd).toFixed(1)}" stroke="var(--amb)" stroke-width=".9"/>
      <text x="${(cx-bw/2-11).toFixed(1)}" y="${(gl+bd/2).toFixed(1)}" font-size="8" fill="var(--amb)" text-anchor="end">D=${Df}m</text>
      <text x="${cx}" y="${(gl+bd+24).toFixed(1)}" font-size="8.5" fill="var(--teal)" text-anchor="middle">B = ${B} m</text>
      <text x="${cx}" y="${gl-30}" font-size="9" fill="var(--teal)" text-anchor="middle">Q</text>
    </svg>`;
  }
  ['bc-shape','bc-b','bc-l','bc-df','bc-c','bc-phi','bc-g','bc-gsat','bc-dw','bc-fs'].forEach(id=>g(id).addEventListener('input',bearing));
  g('bc-shape').addEventListener('input',()=>{
    const s=g('bc-shape').value;
    g('bc-l').disabled = (s!=='square');
    g('bc-l').style.opacity = (s==='square')?'1':'.45';
  });
  bearing();

  document.querySelectorAll('.quiz .q').forEach(q=>{
    const btns=q.querySelectorAll('button');
    btns.forEach(btn=>btn.addEventListener('click',()=>{
      if(q.classList.contains('answered'))return;
      q.classList.add('answered');
      btns.forEach(b=>{ if(b.dataset.v===q.dataset.a)b.classList.add('correct'); else if(b===btn)b.classList.add('wrong'); });
      const a=document.querySelectorAll('.quiz .q.answered').length;
      const r=document.querySelectorAll('.quiz .q.answered button.correct').length;
      g('quiz-score').textContent=r+' / '+a+' answered correctly so far';
    }));
  });
})();
</script>

