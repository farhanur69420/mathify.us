<script is:inline>
(function(){
  const g=id=>document.getElementById(id), v=id=>+g(id).value;
  const GW=9.81, D=Math.PI/180;
  const C1={c:30,p:28,g:17.9}, C2={c:10,p:32,g:18.2};

  function model(){
    const H=v('b8-h'), ratio=v('b8-r'), t1=v('b8-t1');
    const run=ratio*H, crest={x:run,y:H};
    const xo=run-v('b8-cx'), yo=H+v('b8-cy');
    const R=Math.hypot(xo,yo);                 // circle through the toe (0,0)
    const YB=H-t1;                             // layer boundary elevation
    const disc=R*R-(H-yo)*(H-yo);
    const xEnd=disc>0 ? xo+Math.sqrt(disc) : run;
    return {H,ratio,run,crest,xo,yo,R,YB,x0:0,x1:xEnd};
  }
  const ground=(m,x)=> x<0?0 : (x<=m.run ? x/m.ratio : m.H);
  const ybase =(m,x)=> m.yo-Math.sqrt(Math.max(0,m.R*m.R-(x-m.xo)*(x-m.xo)));
  const ywat  =(x,on)=> on ? Math.max(0,0.23*(x-2.0)) : -1e9;

  function slices(m,n,water){
    const b=(m.x1-m.x0)/n, out=[]; let drive=0;
    for(let i=0;i<n;i++){
      const xm=m.x0+(i+0.5)*b, yg=ground(m,xm), yb=ybase(m,xm);
      const h=yg-yb; if(h<=0) continue;
      const h1=Math.max(0,yg-Math.max(yb,m.YB)), h2=Math.max(0,Math.min(yg,m.YB)-yb);
      const W=(C1.g*h1+C2.g*h2)*b;
      const s=(xm-m.xo)/m.R; if(Math.abs(s)>0.999) continue;
      const al=Math.asin(s), l=b/Math.cos(al);
      const u=Math.max(0,Math.min(ywat(xm,water),yg)-yb)*GW;
      const L = yb<m.YB ? C2 : C1;
      drive+=W*Math.sin(al);
      out.push({i:out.length+1,xm,yg,yb,h,h1,h2,W,al,alDeg:al/D,b,l,u,c:L.c,ph:L.p,inLower:yb<m.YB});
    }
    return {rows:out,drive,b};
  }

  function solve(sl){
    const {rows,drive}=sl;
    if(!rows.length||drive<=0) return null;
    const oms=rows.reduce((a,r)=>a+r.c*r.l+Math.max(0,r.W*Math.cos(r.al)-r.u*r.l)*Math.tan(r.ph*D),0)/drive;
    let F=oms; const hist=[];
    for(let k=0;k<60;k++){
      let num=0, bad=false;
      for(const r of rows){
        const ma=Math.cos(r.al)+Math.sin(r.al)*Math.tan(r.ph*D)/F;
        if(ma<0.15){bad=true;break;}
        num+=(r.c*r.b+Math.max(0,r.W-r.u*r.b)*Math.tan(r.ph*D))/ma;
      }
      if(bad) break;
      const Fn=num/drive; hist.push(Fn);
      if(Math.abs(Fn-F)<1e-5){F=Fn;break;}
      F=Fn;
    }
    return {oms,bishop:F,hist,drive};
  }

  /* ── drawing ── */
  function draw(el,m,sl,sel,water,W_,H_){
    const padL=34,padR=14,padT=16,padB=26;
    const xmin=Math.min(-3,m.x0-2), xmax=Math.max(m.x1+2,m.run+4);
    const ymin=Math.min(0,m.yo-m.R)-1, ymax=Math.max(m.H,m.yo)+1;
    const s=Math.min((W_-padL-padR)/(xmax-xmin),(H_-padT-padB)/(ymax-ymin));
    const ox=(W_-(xmax-xmin)*s)/2;
    const X=x=>ox+(x-xmin)*s, Y=y=>(H_-padB)-(y-ymin)*s;

    // ground profile + layer band
    const gp=`M ${X(xmin)} ${Y(0)} L ${X(0)} ${Y(0)} L ${X(m.run)} ${Y(m.H)} L ${X(xmax)} ${Y(m.H)}`;
    const band=`M ${X(xmin)} ${Y(m.YB)} L ${X(xmax)} ${Y(m.YB)}`;
    // arc
    let arc='';
    for(let i=0;i<=90;i++){ const x=m.x0+(m.x1-m.x0)*i/90; arc+=(i?' L ':'M ')+X(x).toFixed(1)+' '+Y(ybase(m,x)).toFixed(1); }
    // mass fill
    let top='';
    for(let i=90;i>=0;i--){ const x=m.x0+(m.x1-m.x0)*i/90; top+=' L '+X(x).toFixed(1)+' '+Y(ground(m,x)).toFixed(1); }
    // slice dividers + selected slice
    let div='',selBox='';
    sl.rows.forEach((r,k)=>{
      const xl=m.x0+k*r.b;
      div+=`<line x1="${X(xl).toFixed(1)}" y1="${Y(ground(m,xl)).toFixed(1)}" x2="${X(xl).toFixed(1)}" y2="${Y(ybase(m,xl)).toFixed(1)}" stroke="var(--bdr2)" stroke-width=".5"/>`;
      if(r.i===sel){
        const a=m.x0+k*r.b, bx=a+r.b;
        let p=`M ${X(a)} ${Y(ground(m,a))}`;
        for(let i=0;i<=14;i++){const x=a+(bx-a)*i/14; p+=` L ${X(x).toFixed(1)} ${Y(ground(m,x)).toFixed(1)}`;}
        for(let i=14;i>=0;i--){const x=a+(bx-a)*i/14; p+=` L ${X(x).toFixed(1)} ${Y(ybase(m,x)).toFixed(1)}`;}
        selBox=`<path d="${p} Z" fill="rgba(78,201,176,.32)" stroke="var(--teal)" stroke-width="1.4"/>`;
      }
    });
    // water table
    let wt='';
    if(water){
      let p='';
      for(let i=0;i<=60;i++){ const x=xmin+(xmax-xmin)*i/60; const yw=Math.min(ywat(x,true),ground(m,x)); p+=(i?' L ':'M ')+X(x).toFixed(1)+' '+Y(Math.max(yw,0)).toFixed(1); }
      wt=`<path d="${p}" fill="none" stroke="#4a9fe0" stroke-width="1.3" stroke-dasharray="5,3"/>`;
    }
    el.innerHTML=`<svg viewBox="0 0 ${W_} ${H_}" style="width:100%;height:auto" id="b8-svg">
      <rect x="${X(xmin)}" y="${Y(m.YB)}" width="${((xmax-xmin)*s).toFixed(1)}" height="${Math.max(0,(Y(ymin)-Y(m.YB))).toFixed(1)}" fill="rgba(120,130,150,.13)"/>
      <path d="${arc}${top} Z" fill="rgba(194,90,59,.15)"/>
      ${div}${selBox}
      <path d="${band}" stroke="var(--bdr2)" stroke-dasharray="4,3" fill="none"/>
      <path d="${gp}" fill="none" stroke="var(--txt2)" stroke-width="1.6"/>
      <path d="${arc}" fill="none" stroke="var(--rust)" stroke-width="2"/>
      ${wt}
      <circle cx="${X(m.xo).toFixed(1)}" cy="${Y(m.yo).toFixed(1)}" r="3" fill="var(--amb)"/>
      <line x1="${X(m.xo).toFixed(1)}" y1="${Y(m.yo).toFixed(1)}" x2="${X(0).toFixed(1)}" y2="${Y(0).toFixed(1)}" stroke="var(--amb)" stroke-width=".7" stroke-dasharray="3,2"/>
      <text x="${(X(m.xo)+5).toFixed(1)}" y="${(Y(m.yo)+3).toFixed(1)}" font-size="9" fill="var(--amb)">O · R=${m.R.toFixed(1)} m</text>
      <text x="${X(xmin)+2}" y="${H_-8}" font-size="8.5" fill="var(--txt2)">upper c'=30 φ'=28 · lower c'=10 φ'=32</text>
    </svg>`;
    // click-to-select
    const svg=g('b8-svg');
    svg.style.cursor='pointer';
    svg.addEventListener('click',ev=>{
      const r=svg.getBoundingClientRect();
      const px=(ev.clientX-r.left)/r.width*W_;
      const xd=xmin+(px-ox)/s;
      const k=Math.floor((xd-m.x0)/sl.b);
      if(k>=0&&k<sl.rows.length){ g('b8-s').value=k+1; render(); }
    });
  }

  function render(){
    const n=Math.round(v('b8-n')), water=g('b8-w').value==='1';
    g('b8-nv').textContent=n;
    const m=model(), sl=slices(m,n,water);
    g('b8-s').max=Math.max(1,sl.rows.length);
    let sel=Math.min(Math.round(v('b8-s')),sl.rows.length||1);
    g('b8-sv').textContent=sel;
    const R=solve(sl);
    draw(g('b8-fig'),m,sl,sel,water,340,215);

    if(!R){ g('b8-res').innerHTML='<div class="verdict v-fail"><span>No valid sliding mass for this geometry</span></div>'; g('b8-detail').innerHTML=''; return; }
    const ok=R.bishop>=1.5;
    g('b8-res').innerHTML=
      `<div class="res"><span>R / centre</span><b>${m.R.toFixed(2)} m · (${m.xo.toFixed(2)}, ${m.yo.toFixed(2)})</b></div>`+
      `<div class="res"><span>Arc spans x</span><b>0 → ${m.x1.toFixed(2)} m</b></div>`+
      `<div class="res"><span>&Sigma;W sin&alpha; (driving)</span><b>${R.drive.toFixed(0)} kN/m</b></div>`+
      `<div class="res"><span>Ordinary Method</span><b>${R.oms.toFixed(3)}</b></div>`+
      `<div class="verdict ${ok?'v-pass':'v-fail'}"><span>Modified Bishop FS</span><b>${R.bishop.toFixed(3)} ${ok?'✓':'⚠'}</b></div>`+
      `<div class="res"><span>Bishop above OMS by</span><b>${(100*(R.bishop-R.oms)/R.bishop).toFixed(1)}% · ${R.hist.length} passes</b></div>`;

    const r=sl.rows[sel-1];
    if(r){
      const ma=Math.cos(r.al)+Math.sin(r.al)*Math.tan(r.ph*D)/R.bishop;
      const num=(r.c*r.b+Math.max(0,r.W-r.u*r.b)*Math.tan(r.ph*D))/ma;
      g('b8-detail').innerHTML=
      `<div class="vcard ${r.inLower?'v-amb':'v-teal'}">
        <span class="vtag">Slice ${r.i} of ${sl.rows.length} — base in the ${r.inLower?'LOWER':'UPPER'} layer (c'=${r.c} kPa, φ'=${r.ph}°)</span>
        <div class="qref" style="margin:.5rem 0 0">
          <div><span>mid-point x</span><span>${r.xm.toFixed(2)} m</span></div>
          <div><span>ground / base y</span><span>${r.yg.toFixed(2)} / ${r.yb.toFixed(2)} m</span></div>
          <div><span>height h</span><span>${r.h.toFixed(2)} m</span></div>
          <div><span>in upper / lower</span><span>${r.h1.toFixed(2)} / ${r.h2.toFixed(2)} m</span></div>
          <div><span>weight W</span><span>${r.W.toFixed(1)} kN/m</span></div>
          <div><span>base angle &alpha;</span><span>${r.alDeg.toFixed(2)}&deg;</span></div>
          <div><span>base length &ell;</span><span>${r.l.toFixed(2)} m</span></div>
          <div><span>pore pressure u</span><span>${r.u.toFixed(1)} kPa</span></div>
          <div><span>driving W sin&alpha;</span><span>${(r.W*Math.sin(r.al)).toFixed(1)} kN/m ${r.al<0?'(resisting)':''}</span></div>
          <div><span>m<sub>&alpha;</sub> at FS=${R.bishop.toFixed(2)}</span><span>${ma.toFixed(4)}</span></div>
          <div><span>resisting term</span><span>${num.toFixed(1)} kN/m</span></div>
          <div><span>share of driving</span><span>${(100*r.W*Math.sin(r.al)/R.drive).toFixed(1)}%</span></div>
        </div>
      </div>`;
    }
  }
  ['b8-n','b8-s','b8-w','b8-h','b8-r','b8-cx','b8-cy','b8-t1'].forEach(id=>g(id).addEventListener('input',render));
  render();

  /* ── static set-up diagram (section 3) ── */
  (function(){
    const m=model(), sl=slices(m,0.0001,true);
    draw(g('b8-setup'),m,{rows:[],b:1},0,true,340,225);
  })();

  /* ── the 10-slice table (section 6) ── */
  (function(){
    const m=model(), sl=slices(m,10,true), R=solve(sl);
    const rows=sl.rows.map(r=>`<tr>
      <td style="padding:.2rem .4rem">${r.i}</td>
      <td style="text-align:right">${r.xm.toFixed(2)}</td>
      <td style="text-align:right">${r.h.toFixed(2)}</td>
      <td style="text-align:right">${r.W.toFixed(0)}</td>
      <td style="text-align:right">${r.alDeg.toFixed(1)}</td>
      <td style="text-align:right">${r.l.toFixed(2)}</td>
      <td style="text-align:right">${r.u.toFixed(1)}</td>
      <td style="text-align:right;color:${r.inLower?'var(--amb)':'var(--teal)'}">${r.c}/${r.ph}</td>
      <td style="text-align:right;color:${r.al<0?'var(--grn)':'var(--txt)'}">${(r.W*Math.sin(r.al)).toFixed(1)}</td></tr>`).join('');
    g('b8-table').innerHTML=`<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:.76rem">
      <tr style="color:var(--mut)"><th style="text-align:left;padding:.25rem .4rem">#</th><th style="text-align:right">x<sub>m</sub></th><th style="text-align:right">h (m)</th><th style="text-align:right">W (kN/m)</th><th style="text-align:right">&alpha; (&deg;)</th><th style="text-align:right">&ell; (m)</th><th style="text-align:right">u (kPa)</th><th style="text-align:right">c'/&phi;'</th><th style="text-align:right">W sin&alpha;</th></tr>
      ${rows}
      <tr style="border-top:1px solid var(--bdr);color:var(--txt)"><td style="padding:.25rem .4rem"><strong>&Sigma;</strong></td><td colspan="7"></td><td style="text-align:right"><strong>${R.drive.toFixed(0)}</strong></td></tr>
      </table></div>
      <p class="small" style="margin-top:.4rem">Amber c'/&phi;' = base in the lower layer; teal = upper layer. Green driving values are negative — those slices resist.</p>`;
  })();

  /* ── iteration box (section 8) ── */
  (function(){
    const m=model(), sl=slices(m,10,true), R=solve(sl);
    const rows=[`<div class="res"><span>Pass 0 — Ordinary Method, first guess</span><b>${R.oms.toFixed(3)}</b></div>`];
    R.hist.slice(0,5).forEach((h,i)=>{
      const prev=i===0?R.oms:R.hist[i-1];
      const d=h-prev;
      rows.push(`<div class="${i===R.hist.length-1||Math.abs(d)<0.001?'verdict v-pass':'res'}"><span>Pass ${i+1}</span><b>${h.toFixed(4)} <span style="color:var(--mut)">(${d>=0?'+':''}${d.toFixed(4)})</span></b></div>`);
    });
    g('b8-iterbox').innerHTML=`<div class="calc-results" style="max-width:520px">${rows.join('')}</div>`;
  })();
})();
</script>

</Base>
