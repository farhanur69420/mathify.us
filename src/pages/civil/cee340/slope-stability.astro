<script is:inline>
(function(){
  const g = id => document.getElementById(id);
  const v = id => +g(id).value;
  const GW = 9.81;

  /* ───────── Infinite slope ───────── */
  function infinite(){
    const wet = g('is-mode').value === 'wet';
    const beta = v('is-beta'), H = v('is-h'), c = v('is-c'), phi = v('is-phi');
    const gm = v('is-g'), gsat = v('is-gsat');
    const br = beta*Math.PI/180, pr = phi*Math.PI/180;
    const gamma = wet ? gsat : gm;
    const gsub = gsat - GW;
    const cosb = Math.cos(br), tanb = Math.tan(br);

    if (beta <= 0 || beta >= 90 || H <= 0 || tanb <= 0) {
      g('is-res').innerHTML = '<div class="verdict v-fail"><span>Slope angle must be between 0&deg; and 90&deg;</span></div>';
      g('is-fig').innerHTML = ''; return;
    }
    const cohTerm = c / (gamma * H * cosb*cosb * tanb);
    const friTerm = (wet ? gsub/gsat : 1) * Math.tan(pr) / tanb;
    const FS = cohTerm + friTerm;
    const denom = tanb - Math.tan(pr);
    const Hcr = denom > 0 ? c / (gamma * cosb*cosb * denom) : Infinity;

    const ok = FS >= 1.5, marginal = FS >= 1.0 && FS < 1.5;
    g('is-res').innerHTML =
      `<div class="res"><span>Cohesion term</span><b>${cohTerm.toFixed(3)}</b></div>` +
      `<div class="res"><span>Friction term${wet ? ' (&times; &gamma;\'/&gamma;<sub>sat</sub> = '+(gsub/gsat).toFixed(3)+')' : ''}</span><b>${friTerm.toFixed(3)}</b></div>` +
      `<div class="verdict ${ok?'v-pass':(marginal?'v-fail':'v-fail')}"><span>Factor of safety</span><b>${FS.toFixed(2)} ${ok?'✓ stable':(marginal?'⚠ marginal':'✗ FAILS')}</b></div>` +
      `<div class="res"><span>Critical depth H<sub>cr</sub></span><b>${Hcr===Infinity?'∞ (β ≤ φ\')':Hcr.toFixed(2)+' m'}</b></div>`;

    // figure
    const W=280, Hh=150, x0=20, y0=125, len=200;
    const dy = len*Math.tan(br);
    const top = Math.min(dy, 95);
    const sc = top/dy || 1;
    const Lx = len*sc;
    g('is-fig').innerHTML = `
    <svg viewBox="0 0 ${W} ${Hh}" style="width:100%;height:auto">
      <polygon points="${x0},${y0} ${x0+Lx},${y0-top} ${x0+Lx},${y0}" fill="var(--surf3)" stroke="var(--bdr2)"/>
      <line x1="${x0+8}" y1="${y0-8*Math.tan(br)*sc+10}" x2="${x0+Lx}" y2="${y0-top+10}" stroke="var(--rust)" stroke-width="1.8" stroke-dasharray="5,3"/>
      <text x="${x0+Lx-6}" y="${y0-top+22}" font-size="9" fill="var(--rust)" text-anchor="end">failure plane, H=${H} m</text>
      ${wet?`<line x1="${x0+6}" y1="${y0-6*Math.tan(br)*sc+2}" x2="${x0+Lx}" y2="${y0-top+2}" stroke="#4a9fe0" stroke-width="1.4"/><text x="${x0+Lx-6}" y="${y0-top-4}" font-size="9" fill="#4a9fe0" text-anchor="end">water table</text>`:''}
      <path d="M ${x0+34} ${y0} A 34 34 0 0 0 ${x0+34*Math.cos(br)} ${y0-34*Math.sin(br)}" fill="none" stroke="var(--amb)" stroke-width="1"/>
      <text x="${x0+40}" y="${y0-6}" font-size="9" fill="var(--amb)">β=${beta}°</text>
    </svg>`;
  }
  ['is-mode','is-beta','is-h','is-c','is-phi','is-g','is-gsat'].forEach(id=>g(id).addEventListener('input', infinite));
  infinite();

  /* ───────── Critical circle search ───────── */
  function analyseCircle(xc, yc, R, H, L, tanb, c, tanphi, gamma, ru, n){
    const ground = x => x <= 0 ? H : (x >= L ? 0 : H - x*tanb);
    const bot = x => yc - Math.sqrt(Math.max(0, R*R - (x-xc)*(x-xc)));
    // find contiguous region where ground is above the arc
    const steps = 400, xa = xc - R, xb = xc + R, dx = (xb-xa)/steps;
    let xL = null, xR = null;
    for (let i=0;i<=steps;i++){
      const x = xa + i*dx;
      if (ground(x) - bot(x) > 1e-6){ if (xL===null) xL = x; xR = x; }
    }
    if (xL===null || xR-xL < 0.4*H) return null;
    const b = (xR-xL)/n;
    let sumDrive=0, omsResist=0, deepest=0, sumW=0;
    const slices=[];
    for (let i=0;i<n;i++){
      const xm = xL + (i+0.5)*b;
      const h = ground(xm) - bot(xm);
      if (h <= 0) continue;
      // The slope descends to the right, so the slide rotates counter-clockwise:
      // the crest drops and the toe is pushed out. Mass UPSLOPE of the centre
      // (x < xc) therefore drives the failure, hence (xc - xm), not (xm - xc).
      const s = (xc-xm)/R;
      if (Math.abs(s) > 0.9999) return null;
      const alpha = Math.asin(s);
      const W = gamma*b*h;
      const l = b/Math.cos(alpha);
      const u = ru*gamma*h;
      sumDrive += W*Math.sin(alpha);
      sumW += W;
      omsResist += c*l + Math.max(0, W*Math.cos(alpha) - u*l)*tanphi;
      deepest = Math.max(deepest, h);
      slices.push({i:i+1, W, alpha:alpha*180/Math.PI, l, u, b, h});
    }
    // Reject near-symmetric circles whose driving moment all but cancels: they
    // are geometrically valid but physically meaningless, and produce huge FS.
    if (sumDrive <= 0.02*sumW || slices.length < 4) return null;
    const fsOMS = omsResist/sumDrive;
    // Bishop iteration
    let fs = Math.max(0.3, fsOMS), ok=true, iters=0;
    for (let k=0;k<60;k++){
      let num=0;
      for (const s of slices){
        const a = s.alpha*Math.PI/180;
        const ma = Math.cos(a) + Math.sin(a)*tanphi/fs;
        if (ma < 0.2){ ok=false; break; }
        num += (c*s.b + Math.max(0,(s.W - s.u*s.b))*tanphi)/ma;
      }
      if(!ok) break;
      const next = num/sumDrive;
      iters = k+1;
      if (Math.abs(next-fs) < 1e-4){ fs = next; break; }
      fs = next;
    }
    return { fsOMS, fsBishop: ok?fs:null, iters, xL, xR, xc, yc, R, slices, sumDrive, omsResist, deepest };
  }

  function search(){
    const H=v('sl-h'), beta=v('sl-beta'), c=v('sl-c'), phi=v('sl-phi'), gamma=v('sl-g');
    const ru=v('sl-ru')/100, n=Math.max(4,Math.min(40,Math.round(v('sl-n'))));
    g('sl-ru-v').textContent = ru.toFixed(2);
    if (beta<=0||beta>=90||H<=0){ g('sl-res').innerHTML='<div class="verdict v-fail"><span>Invalid slope geometry</span></div>'; return; }
    const tanb = Math.tan(beta*Math.PI/180), tanphi = Math.tan(phi*Math.PI/180);
    const L = H/tanb;
    let best=null;
    for (let i=0;i<=9;i++){
      const xc = -0.4*H + i*(L+1.6*H)/9;
      for (let j=0;j<=7;j++){
        const yc = H + 0.15*H + j*(2.2*H)/7;
        for (let k=0;k<=7;k++){
          const R = 0.55*H + k*(2.6*H)/7 + (yc-H)*0.5;
          const r = analyseCircle(xc,yc,R,H,L,tanb,c,tanphi,gamma,ru,n);
          if (r && r.fsBishop && r.deepest > 0.15*H){
            if (!best || r.fsBishop < best.fsBishop) best = r;
          }
        }
      }
    }
    if(!best){ g('sl-res').innerHTML='<div class="verdict v-fail"><span>No valid slip circle found — try adjusting geometry</span></div>'; g('sl-fig').innerHTML=''; g('sl-table').innerHTML=''; return; }

    const fb = best.fsBishop, safe = fb>=1.5, marg = fb>=1.0;
    g('sl-res').innerHTML =
      `<div class="verdict ${safe?'v-pass':'v-fail'}"><span>Critical FS (Bishop)</span><b>${fb.toFixed(3)} ${safe?'✓':(marg?'⚠':'✗')}</b></div>` +
      `<div class="res"><span>Same circle, OMS</span><b>${best.fsOMS.toFixed(3)}</b></div>` +
      `<div class="res"><span>OMS conservative by</span><b>${(100*(fb-best.fsOMS)/fb).toFixed(1)}%</b></div>` +
      `<div class="res"><span>Bishop iterations</span><b>${best.iters}</b></div>` +
      `<div class="res"><span>Max slide depth</span><b>${best.deepest.toFixed(1)} m</b></div>` +
      `<div class="res"><span>&Sigma;W sin&alpha; (driving)</span><b>${best.sumDrive.toFixed(0)} kN/m</b></div>`;

    // ── figure ──
    const ground = x => x <= 0 ? H : (x >= L ? 0 : H - x*tanb);
    const bot = x => best.yc - Math.sqrt(Math.max(0, best.R*best.R - (x-best.xc)*(x-best.xc)));
    const padL=26,padR=18,padT=16,padB=26,Wp=340,Hp=220;
    const xmin=Math.min(best.xL,-0.15*H), xmax=Math.max(best.xR,L+0.15*H);
    const ymin=Math.min(0, best.yc-best.R);
    // Always frame the circle centre: the radius line is what makes the
    // construction readable, and a centre drawn off-canvas looks like a bug.
    const ymax=Math.max(H, best.yc + 0.08*H);
    const s=Math.min((Wp-padL-padR)/(xmax-xmin),(Hp-padT-padB)/(ymax-ymin));
    const xOff=(Wp-(xmax-xmin)*s)/2;   // centre the drawing in the viewBox
    const X=x=>xOff+(x-xmin)*s, Y=y=>(Hp-padB)-(y-ymin)*s;

    const N=90, arcPts=[], gndPts=[];
    for(let i=0;i<=N;i++){
      const x=best.xL+(best.xR-best.xL)*i/N;
      arcPts.push([x, bot(x)]); gndPts.push([x, ground(x)]);
    }
    const pts = a => a.map(p=>X(p[0]).toFixed(1)+' '+Y(p[1]).toFixed(1)).join(' L ');
    const arcPath = 'M ' + pts(arcPts);
    const massPath = 'M ' + pts(gndPts) + ' L ' + pts(arcPts.slice().reverse()) + ' Z';
    const gnd = `M ${X(xmin)} ${Y(H)} L ${X(0)} ${Y(H)} L ${X(L)} ${Y(0)} L ${X(xmax)} ${Y(0)}`;

    let div='';
    for(let i=1;i<best.slices.length;i++){
      const xm=best.xL+i*best.slices[0].b;
      const gy=ground(xm), by=bot(xm);
      if(gy>by) div+=`<line x1="${X(xm).toFixed(1)}" y1="${Y(gy).toFixed(1)}" x2="${X(xm).toFixed(1)}" y2="${Y(by).toFixed(1)}" stroke="var(--bdr2)" stroke-width=".6" stroke-dasharray="2,2"/>`;
    }
    const oMark = `
      <circle cx="${X(best.xc)}" cy="${Y(best.yc)}" r="2.5" fill="var(--amb)"/>
      <line x1="${X(best.xc)}" y1="${Y(best.yc)}" x2="${X(best.xR)}" y2="${Y(bot(best.xR))}" stroke="var(--amb)" stroke-width=".7" stroke-dasharray="3,2"/>
      <text x="${X(best.xc)+5}" y="${Y(best.yc)+3}" font-size="9" fill="var(--amb)">O · R=${best.R.toFixed(1)} m</text>`;

    g('sl-fig').innerHTML=`
    <svg viewBox="0 0 ${Wp} ${Hp}" style="width:100%;height:auto">
      <path d="${massPath}" fill="rgba(194,90,59,0.15)" stroke="none"/>
      ${div}
      <path d="${gnd}" fill="none" stroke="var(--bdr2)" stroke-width="1.6"/>
      <path d="${arcPath}" fill="none" stroke="var(--rust)" stroke-width="1.9"/>
      ${oMark}
      <text x="${X(xmin).toFixed(0)}" y="${Hp-8}" font-size="9" fill="var(--txt2)">H=${H} m, β=${beta}°</text>
      <text x="${Wp-padR}" y="${Hp-8}" font-size="9" fill="var(--rust)" text-anchor="end">critical circle</text>
    </svg>`;

    // ── slice table ──
    let rows = best.slices.map(sl=>{
      const a=sl.alpha*Math.PI/180;
      const drive=sl.W*Math.sin(a);
      const res=c*sl.l+Math.max(0,sl.W*Math.cos(a)-sl.u*sl.l)*tanphi;
      return `<tr><td style="padding:.2rem .4rem">${sl.i}</td><td style="text-align:right">${sl.h.toFixed(2)}</td><td style="text-align:right">${sl.W.toFixed(1)}</td><td style="text-align:right">${sl.alpha.toFixed(1)}</td><td style="text-align:right">${sl.l.toFixed(2)}</td><td style="text-align:right">${sl.u.toFixed(1)}</td><td style="text-align:right">${drive.toFixed(1)}</td><td style="text-align:right">${res.toFixed(1)}</td></tr>`;
    }).join('');
    g('sl-table').innerHTML=`<details><summary style="cursor:pointer;font-size:.82rem;color:var(--teal)">Show the ${best.slices.length}-slice table for the critical circle</summary>
      <div style="overflow-x:auto;margin-top:.6rem"><table style="width:100%;border-collapse:collapse;font-size:.75rem">
      <tr style="color:var(--mut)"><th style="text-align:left;padding:.2rem .4rem">#</th><th style="text-align:right">h (m)</th><th style="text-align:right">W (kN/m)</th><th style="text-align:right">α (°)</th><th style="text-align:right">ℓ (m)</th><th style="text-align:right">u (kPa)</th><th style="text-align:right">W sinα</th><th style="text-align:right">OMS resist.</th></tr>
      ${rows}
      <tr style="border-top:1px solid var(--bdr);color:var(--txt)"><td style="padding:.2rem .4rem"><strong>Σ</strong></td><td colspan="5"></td><td style="text-align:right"><strong>${best.sumDrive.toFixed(1)}</strong></td><td style="text-align:right"><strong>${best.omsResist.toFixed(1)}</strong></td></tr>
      </table></div></details>`;
  }
  ['sl-h','sl-beta','sl-c','sl-phi','sl-g','sl-ru','sl-n'].forEach(id=>g(id).addEventListener('input', search));
  search();

  /* ───────── Quiz ───────── */
  document.querySelectorAll('.quiz .q').forEach(q=>{
    const btns=q.querySelectorAll('button');
    btns.forEach(btn=>btn.addEventListener('click',()=>{
      if(q.classList.contains('answered'))return;
      q.classList.add('answered');
      btns.forEach(b=>{ if(b.dataset.v===q.dataset.a)b.classList.add('correct'); else if(b===btn)b.classList.add('wrong'); });
      const a=document.querySelectorAll('.quiz .q.answered').length;
      const r=document.querySelectorAll('.quiz .q.answered button.correct').length;
      g('quiz-score').textContent=r+' / '+a+' answered correctly so far';
    }));
  });
})();
</script>

</Base>
