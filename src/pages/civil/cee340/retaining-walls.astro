<script is:inline>
(function(){
  const ids = ['rw-hs','rw-d','rw-b','rw-ltoe','rw-ttop','rw-tbot','rw-gs','rw-phi','rw-phi2','rw-c2','rw-gc','rw-qult'];
  const val = id => +document.getElementById(id).value;

  function calc(){
    const Hs=val('rw-hs'), D=val('rw-d'), B=val('rw-b'), Ltoe=val('rw-ltoe');
    const tTop=val('rw-ttop'), tBot=val('rw-tbot');
    const gS=val('rw-gs'), phi=val('rw-phi'), phi2=val('rw-phi2'), c2=val('rw-c2');
    const gC=val('rw-gc'), qult=val('rw-qult');

    const heelW = B - Ltoe - tBot;
    const Hp = Hs + D;
    const Ka = Math.pow(Math.tan(Math.PI/4 - phi*Math.PI/360), 2);
    const Pa = 0.5*Ka*gS*Hp*Hp;
    const Mo = Pa*Hp/3;

    const parts = [
      ['Stem (rect)',  tTop*Hs*gC,               Ltoe + tBot - tTop/2],
      ['Stem (taper)', 0.5*(tBot-tTop)*Hs*gC,    Ltoe + 2*(tBot-tTop)/3],
      ['Base slab',    B*D*gC,                   B/2],
      ['Soil on heel', heelW*Hs*gS,              Ltoe + tBot + heelW/2]
    ];
    let V=0, Mr=0;
    parts.forEach(p => { V += p[1]; Mr += p[1]*p[2]; });

    const fsOT = Mr/Mo;
    const Fr = V*Math.tan(2/3*phi2*Math.PI/180) + (2/3)*c2*B;
    const fsSL = Fr/Pa;
    const xbar = (Mr-Mo)/V;
    const e = B/2 - xbar;
    const qmax = (V/B)*(1 + 6*e/B);
    const qmin = (V/B)*(1 - 6*e/B);
    const fsBC = qult/qmax;
    const geomOK = heelW > 0 && tBot >= tTop && B > Ltoe + tBot;

    const row = (label, value, ok) =>
      `<div class="verdict ${ok?'v-pass':'v-fail'}"><span>${label}</span><b>${value} ${ok?'✓':'✗'}</b></div>`;
    const plain = (label, value) =>
      `<div class="res"><span>${label}</span><b>${value}</b></div>`;

    document.getElementById('rw-res').innerHTML = !geomOK
      ? `<div class="verdict v-fail"><span>Geometry invalid — check base width, toe and stem thicknesses</span></div>`
      : plain('K&#8336; / P&#8336;', Ka.toFixed(3)+' / '+Pa.toFixed(1)+' kN/m')
      + plain('&Sigma;V / &Sigma;M<sub>R</sub>', V.toFixed(1)+' kN/m / '+Mr.toFixed(0)+' kN·m')
      + row('FS overturning (&ge; 2)', fsOT.toFixed(2), fsOT>=2)
      + row('FS sliding (&ge; 1.5)', fsSL.toFixed(2), fsSL>=1.5)
      + row('Eccentricity e (&le; B/6 = '+(B/6).toFixed(2)+' m)', e.toFixed(3)+' m', Math.abs(e)<=B/6)
      + row('FS bearing (&ge; 3)', fsBC.toFixed(2), fsBC>=3)
      + plain('q<sub>max</sub> / q<sub>min</sub>', qmax.toFixed(1)+' / '+qmin.toFixed(1)+' kPa');

    // ── cross-section figure ──
    const padL=30, padR=88, padT=22, padB=28, W=320, H=240;
    const s = Math.min((W-padL-padR)/B, (H-padT-padB)/Hp);
    const X = x => padL + x*s;
    const Y = y => (H-padB) - y*s;
    const stem = `${X(Ltoe)},${Y(D)} ${X(Ltoe+tBot)},${Y(D)} ${X(Ltoe+tBot)},${Y(Hp)} ${X(Ltoe+tBot-tTop)},${Y(Hp)}`;

    document.getElementById('rw-fig').innerHTML = geomOK ? `
    <svg viewBox="0 0 ${W} ${H}" style="width:100%;height:auto">
      <rect x="${X(Ltoe+tBot)}" y="${Y(Hp)}" width="${heelW*s}" height="${Hs*s}" fill="rgba(212,169,74,0.10)" stroke="var(--aline)"/>
      <rect x="${X(0)}" y="${Y(D)}" width="${B*s}" height="${D*s}" fill="var(--surf3)" stroke="var(--bdr2)"/>
      <polygon points="${stem}" fill="var(--surf3)" stroke="var(--bdr2)"/>
      <line x1="${X(B)}" y1="${Y(0)}" x2="${X(B)}" y2="${Y(Hp)}" stroke="var(--teal)" stroke-width="1" stroke-dasharray="3,2"/>
      <polygon points="${X(B)},${Y(0)} ${X(B)+Math.min(40,Pa*s/9)},${Y(0)} ${X(B)},${Y(Hp)}" fill="rgba(78,201,176,0.20)" stroke="var(--teal)" stroke-width="1.2"/>
      <line x1="${X(B)+20}" y1="${Y(Hp/3)}" x2="${X(B)+2}" y2="${Y(Hp/3)}" stroke="var(--teal)" stroke-width="1.6" marker-end="url(#pa)"/>
      <defs><marker id="pa" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="var(--teal)"/></marker></defs>
      <text x="${X(B)+24}" y="${Y(Hp/3)-4}" font-size="9" fill="var(--teal)">P&#8336;=${Pa.toFixed(0)}</text>
      <circle cx="${X(0)}" cy="${Y(0)}" r="3" fill="var(--amb)"/>
      <text x="${X(0)-4}" y="${Y(0)+13}" font-size="9" fill="var(--amb)" text-anchor="middle">toe</text>
      <line x1="${X(0)}" y1="${H-12}" x2="${X(B)}" y2="${H-12}" stroke="var(--mut)" stroke-width="1"/>
      <text x="${X(B/2)}" y="${H-3}" font-size="9" fill="var(--mut)" text-anchor="middle">B = ${B} m</text>
      <text x="${X(Ltoe+tBot)+4}" y="${Y(Hp)-5}" font-size="9" fill="var(--amb)">backfill on heel</text>
    </svg>` : '';
  }

  ids.forEach(id => document.getElementById(id).addEventListener('input', calc));
  calc();

  document.querySelectorAll('.quiz .q').forEach(q => {
    const btns = q.querySelectorAll('button');
    btns.forEach(btn => btn.addEventListener('click', () => {
      if (q.classList.contains('answered')) return;
      q.classList.add('answered');
      if(btn.dataset.v===q.dataset.a)q.classList.add('gotit');
      btns.forEach(b => {
        if (b.dataset.v === q.dataset.a) b.classList.add('correct');
        else if (b === btn) b.classList.add('wrong');
      });
      const answered = document.querySelectorAll('.quiz .q.answered').length;
      const right = document.querySelectorAll('.quiz .q.gotit').length;
      document.getElementById('quiz-score').textContent = right + ' / ' + answered + ' answered correctly so far';
    }));
  });
})();
</script>

