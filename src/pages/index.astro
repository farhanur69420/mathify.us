---
import Main from '../layouts/Main.astro';
---
<Main title="Mathify" description="Free maths, physics and civil engineering explained intuition-first — the idea and the picture before the formula, then worked step by step. SSC board solutions, university course guides, and interactive calculators.">

<style>
  .hero {
    padding: 5rem 2rem 3rem;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  .hero h1 {
    font-family: 'Space Mono', monospace;
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -.02em;
    margin-bottom: .6rem;
  }
  .hero h1 span { color: var(--teal); }
  .hero p {
    color: var(--txt2);
    font-size: 1rem;
    max-width: 480px;
    margin: 0 auto;
  }

  /* Subjects */
  .subjects {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem 3rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .scard {
    background: var(--surf);
    border: 1px solid var(--bdr);
    border-radius: 8px;
    padding: 2rem 1.5rem;
    text-decoration: none;
    transition: border-color .2s, transform .2s;
  }
  .scard:hover { border-color: var(--teal); transform: translateY(-2px); }
  .scard .icon { font-size: 1.8rem; margin-bottom: .8rem; display: block; }
  .scard h2 {
    font-size: .95rem;
    font-weight: 700;
    margin-bottom: .3rem;
  }
  .scard p { font-size: .8rem; color: var(--txt2); line-height: 1.5; }

  /* Section */
  .section {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem 3rem;
  }
  .slabel {
    font-family: 'Space Mono', monospace;
    font-size: .6rem;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--mut);
    margin-bottom: 1rem;
    display: flex; align-items: center; gap: .8rem;
  }
  .slabel::after { content: ''; flex: 1; height: 1px; background: var(--bdr); }

  /* SSC grid */
  .ssc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: .6rem;
  }
  .ssc-link {
    background: var(--surf);
    border: 1px solid var(--bdr);
    border-radius: 6px;
    padding: .8rem 1rem;
    text-decoration: none;
    font-size: .78rem;
    font-weight: 600;
    transition: border-color .2s;
    display: flex; align-items: center; justify-content: space-between;
  }
  .ssc-link:hover { border-color: var(--amb); color: var(--amb); }
  .ssc-link .yr { color: var(--amb); font-family: 'Space Mono', monospace; font-size: .7rem; }

  /* Quick links */
  .qgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: .6rem;
  }
  .qlink {
    background: var(--surf);
    border: 1px solid var(--bdr);
    border-radius: 6px;
    padding: .8rem 1rem;
    text-decoration: none;
    font-size: .78rem;
    color: var(--txt2);
    transition: border-color .2s, color .2s;
  }
  .qlink:hover { border-color: var(--teal); color: var(--teal); }
  .qlink .tag {
    font-family: 'Space Mono', monospace;
    font-size: .55rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--mut);
    display: block;
    margin-bottom: .2rem;
  }

  /* ── SITE SEARCH ── */
  .search {
    display: flex; gap: .5rem; margin: 1.6rem auto 0;
    max-width: 560px;
  }
  .search input {
    flex: 1 1 auto; min-width: 0;
    background: var(--surf); border: 1px solid var(--bdr);
    border-radius: 8px; padding: .7rem .9rem;
    color: var(--txt); font-family: inherit; font-size: .82rem;
  }
  .search input::placeholder { color: var(--mut); }
  .search input:focus { outline: none; border-color: var(--teal); }
  .search button {
    flex: 0 0 auto;
    background: var(--tdim); border: 1px solid var(--tline);
    color: var(--teal); border-radius: 8px;
    padding: .7rem 1.1rem; cursor: pointer;
    font-family: 'Space Mono', monospace; font-size: .74rem;
    letter-spacing: .06em; text-transform: uppercase;
    transition: background .2s;
  }
  .search button:hover { background: rgba(78,201,176,.18); }
  .search-status {
    max-width: 560px; margin: .5rem auto 0;
    font-family: 'Space Mono', monospace; font-size: .68rem;
    color: var(--mut); min-height: 1em; text-align: left;
  }
  /* Result items are injected via innerHTML, so Astro's scoped styles never
     reach them — everything below the container must be :global(). */
  .results { max-width: 560px; margin: .6rem auto 0; text-align: left; }
  .results :global(a) {
    display: block; text-decoration: none;
    background: var(--surf); border: 1px solid var(--bdr);
    border-radius: 8px; padding: .7rem .9rem; margin-bottom: .45rem;
    transition: border-color .2s;
  }
  .results :global(a:hover), .results :global(a:focus) { border-color: var(--teal); outline: none; }
  .results :global(.r-top) { display: flex; align-items: baseline; gap: .5rem; justify-content: space-between; }
  .results :global(.r-title) { font-size: .82rem; color: var(--txt); font-weight: 600; }
  .results :global(.r-sec) {
    flex: 0 0 auto; white-space: nowrap;
    font-family: 'Space Mono', monospace; font-size: .55rem;
    letter-spacing: .1em; text-transform: uppercase;
    color: var(--amb); background: var(--adim);
    border: 1px solid var(--aline); border-radius: 99px; padding: .1rem .5rem;
  }
  .results :global(.r-snip) { font-size: .72rem; color: var(--txt2); margin-top: .3rem; line-height: 1.55; }
  .results :global(mark) { background: rgba(78,201,176,.22); color: var(--teal); padding: 0 .1em; border-radius: 2px; }
  .results :global(.r-url) { font-family: 'Space Mono', monospace; font-size: .6rem; color: var(--mut); margin-top: .25rem; }

  @media (max-width: 600px) {
    .subjects { grid-template-columns: 1fr; }
    .hero { padding: 3.5rem 1.5rem 2rem; }
    .section { padding-left: 1.5rem; padding-right: 1.5rem; }
    .search button { padding: .7rem .8rem; }
  }
</style>

<!-- HERO -->
<div class="hero">
  <h1><span>mathify</span></h1>
  <p>Every page here is built to feel like sitting with a good tutor: the idea first, in
     pictures you can hold onto &mdash; then the equations, step by step. Free, no ads, no paywall.</p>

  <!-- SITE SEARCH -->
  <form class="search" id="site-search" role="search" autocomplete="off">
    <input type="search" id="q" placeholder="Search every page — try “Bishop”, “bearing capacity”, “tension crack”…"
           aria-label="Search the site" />
    <button type="submit" id="q-btn" aria-label="Search">Search</button>
  </form>
  <div class="search-status" id="q-status" role="status" aria-live="polite"></div>
  <div class="results" id="q-results"></div>
</div>

<!-- SUBJECTS -->
<div class="subjects">
  <a href="/math" class="scard">
    <span class="icon">&sum;</span>
    <h2>Mathematics</h2>
    <p>Class 9&ndash;12 guides, algebra, calculus, geometry, and more.</p>
  </a>
  <a href="/physics" class="scard">
    <span class="icon">&hbar;</span>
    <h2>Physics</h2>
    <p>Mechanics, waves, thermodynamics, and electromagnetism.</p>
  </a>
  <a href="/civil" class="scard">
    <span class="icon">&#9651;</span>
    <h2>Civil Engineering</h2>
    <p>RC design, structural analysis, traffic engineering.</p>
  </a>
</div>

<!-- SSC QUESTION SOLUTIONS -->
<div class="section">
  <div class="slabel">SSC Mathematics — All 9 Boards, 2020–2025</div>
  <div class="ssc-grid" style="margin-bottom:1rem;">
    <a href="/ssc/" class="ssc-link" style="border-color:rgba(240,180,41,.3);background:rgba(240,180,41,.05);">
      <span>📘 SSC Math Hub</span><span class="yr">All Boards</span>
    </a>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:.4rem;">
    <a href="/ssc/boards/dhaka-2025.html" class="ssc-link">Dhaka <span class="yr">2025</span></a>
    <a href="/ssc/boards/rajshahi-2025.html" class="ssc-link">Rajshahi <span class="yr">2025</span></a>
    <a href="/ssc/boards/chittagong-2025.html" class="ssc-link">Chittagong <span class="yr">2025</span></a>
    <a href="/ssc/boards/jessore-2025.html" class="ssc-link">Jessore <span class="yr">2025</span></a>
    <a href="/ssc/boards/comilla-2025.html" class="ssc-link">Comilla <span class="yr">2025</span></a>
    <a href="/ssc/boards/barisal-2025.html" class="ssc-link">Barisal <span class="yr">2025</span></a>
    <a href="/ssc/boards/sylhet-2025.html" class="ssc-link">Sylhet <span class="yr">2025</span></a>
    <a href="/ssc/boards/dinajpur-2025.html" class="ssc-link">Dinajpur <span class="yr">2025</span></a>
    <a href="/ssc/boards/mymensingh-2025.html" class="ssc-link">Mymensingh <span class="yr">2025</span></a>
  </div>
  <div style="margin-top:.5rem;display:flex;gap:.4rem;flex-wrap:wrap;">
    <a href="/ssc/boards/dhaka-2024.html" class="ssc-link" style="font-size:.7rem;padding:.5rem .8rem;">Dhaka 2024</a>
    <a href="/ssc/boards/dhaka-2023.html" class="ssc-link" style="font-size:.7rem;padding:.5rem .8rem;">Dhaka 2023</a>
    <a href="/ssc/boards/dhaka-2022.html" class="ssc-link" style="font-size:.7rem;padding:.5rem .8rem;">Dhaka 2022</a>
    <a href="/ssc/boards/dhaka-2021.html" class="ssc-link" style="font-size:.7rem;padding:.5rem .8rem;">Dhaka 2021</a>
    <a href="/ssc/boards/dhaka-2020.html" class="ssc-link" style="font-size:.7rem;padding:.5rem .8rem;">Dhaka 2020</a>
    <a href="/ssc/" class="ssc-link" style="font-size:.7rem;padding:.5rem .8rem;color:var(--amb);">View All 54 Papers →</a>
  </div>
</div>

<!-- COMING SOON -->
<div class="section">
  <div class="slabel">Coming Soon</div>
  <div class="qgrid">
    <a href="/hsc" class="qlink"><span class="tag">Exam Prep</span>HSC</a>
    <a href="/o-level" class="qlink"><span class="tag">Exam Prep</span>O Level</a>
    <a href="/a-level" class="qlink"><span class="tag">Exam Prep</span>A Level</a>
    <a href="/bcs" class="qlink"><span class="tag">Exam Prep</span>BCS</a>
    <a href="/sat-prep" class="qlink"><span class="tag">Exam Prep</span>SAT Prep</a>
    <a href="/shop" class="qlink"><span class="tag">Store</span>Merch &amp; Watches</a>
    <a href="/explore" class="qlink"><span class="tag">More</span>Explore</a>
  </div>
</div>

<script is:inline>
(function(){
  const form = document.getElementById('site-search');
  const input = document.getElementById('q');
  const status = document.getElementById('q-status');
  const out = document.getElementById('q-results');
  let index = null, loading = null;

  const esc = s => s.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  const rx = t => new RegExp(t.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'), 'gi');

  function load(){
    if (index) return Promise.resolve(index);
    if (loading) return loading;
    status.textContent = 'Loading search index…';
    loading = fetch('/search-index.json')
      .then(r => { if(!r.ok) throw new Error('HTTP '+r.status); return r.json(); })
      .then(d => { index = d.pages; status.textContent = ''; return index; })
      .catch(e => { status.textContent = 'Search unavailable ('+e.message+')'; loading = null; throw e; });
    return loading;
  }

  function snippet(text, terms){
    let at = -1;
    for (const t of terms){ const i = text.toLowerCase().indexOf(t); if(i>=0 && (at<0||i<at)) at=i; }
    if (at < 0) at = 0;
    const from = Math.max(0, at - 80);
    let s = text.slice(from, from + 210);
    if (from > 0) s = '…' + s;
    if (from + 210 < text.length) s += '…';
    s = esc(s);
    for (const t of terms) s = s.replace(rx(t), m => '<mark>' + m + '</mark>');
    return s;
  }

  function search(qRaw){
    const q = qRaw.trim();
    if (!q){ out.innerHTML=''; status.textContent=''; return; }
    const terms = q.toLowerCase().split(/\s+/).filter(Boolean);

    const hits = [];
    for (const p of index){
      const hay = p.x.toLowerCase(), title = p.t.toLowerCase();
      let score = 0, all = true;
      for (const t of terms){
        const inTitle = title.includes(t);
        const n = hay.split(t).length - 1;
        if (!n && !inTitle){ all = false; break; }
        score += n + (inTitle ? 25 : 0);
      }
      if (all) hits.push({ p, score });
    }
    hits.sort((a,b) => b.score - a.score);

    if (!hits.length){
      status.textContent = 'No matches for “' + q + '”';
      out.innerHTML = '';
      return;
    }
    status.textContent = hits.length + ' page' + (hits.length>1?'s':'') + ' matching “' + q + '”';
    out.innerHTML = hits.slice(0, 20).map(({p}) =>
      '<a href="' + p.u + '">' +
        '<div class="r-top"><span class="r-title">' + esc(p.t) + '</span>' +
        '<span class="r-sec">' + esc(p.s) + '</span></div>' +
        '<div class="r-snip">' + snippet(p.x, terms) + '</div>' +
        '<div class="r-url">' + esc(p.u) + '</div>' +
      '</a>').join('');
  }

  let timer;
  const run = () => load().then(() => search(input.value)).catch(()=>{});
  input.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(run, 160); });
  input.addEventListener('focus', load, { once: true });
  form.addEventListener('submit', e => { e.preventDefault(); run(); });
  input.addEventListener('keydown', e => {
    if (e.key === 'Escape'){ input.value=''; out.innerHTML=''; status.textContent=''; }
  });
})();
</script>

</Main>
